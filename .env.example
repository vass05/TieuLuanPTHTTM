# Server only. Never commit .env or put these values in browser JavaScript.
GEMINI_API_KEY=
ASSISTANT_EXTERNAL_ENABLED=true
ASSISTANT_GEMINI_MODEL=gemini-3.5-flash-lite

# Set neo4j after importing the reviewed corpus to the database.
DIABETES_KB_BACKEND=local
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
