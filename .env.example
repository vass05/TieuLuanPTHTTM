# Dùng các giá trị này trên máy chủ. Giữ tệp .env ngoài Git và mã JavaScript phía trình duyệt.
GEMINI_API_KEY=
ASSISTANT_EXTERNAL_ENABLED=true
ASSISTANT_GEMINI_MODEL=gemini-3.5-flash-lite

# Đặt backend thành neo4j sau khi nhập kho bằng scripts/import_diabetes_neo4j.py.
DIABETES_KB_BACKEND=local
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
