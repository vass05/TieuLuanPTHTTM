{`key`: "bc9cea01798e92613d7aba27|SB48A4201DD", `properties`: {`kind`: "document", `label`: "Chỉ số tiểu đường thai kỳ nguy hiểm như thế nào đối với thai nhi", `id`: "SB48A4201DD", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “Mọi bậc cha mẹ đều nên tìm hiểu chi tiết về sự phát triển của thai nhi qua từng tuần.”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "6ce14d667188243ab8e1eeeab8020958e388880715a2158575f97cd2cd751f1d", `support_quotes`: ["Mọi bậc cha mẹ đều nên tìm hiểu chi tiết về sự phát triển của thai nhi qua từng tuần."]}},
{`key`: "bc9cea01798e92613d7aba27|SB5A9A09453", `properties`: {`kind`: "document", `label`: "Người bệnh tiểu đường nên ăn loại trái cây gì?", `id`: "SB5A9A09453", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về dinh dưỡng và đái tháo đường. Trích đoạn từ bài gốc: “Bưởi, cam, quýt là các loại trái cây có chỉ số đường huyết thấp và chứa nhiều chất xơ.”", `section`: "Dinh dưỡng và đái tháo đường", `topic`: "nutrition", `category`: "nutrition", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "090cea5b962c8449775263c625dad157ec294a031d736199925faf9d8d0d535c", `support_quotes`: ["Bưởi, cam, quýt là các loại trái cây có chỉ số đường huyết thấp và chứa nhiều chất xơ."]}},
{`key`: "bc9cea01798e92613d7aba27|SB78F520969", `properties`: {`kind`: "document", `label`: "Kết quả xét nghiệm Glucose 6,5mmol/L có phải tiền tiểu đường không và hướng điều trị như thế nào?", `id`: "SB78F520969", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về xét nghiệm và sàng lọc đái tháo đường. Trích đoạn từ bài gốc: “Bạn nên đăng ký khám Nội tiết để được tư vấn làm các xét nghiệm để làm rõ chẩn đoán.”", `section`: "Xét nghiệm và sàng lọc đái tháo đường", `topic`: "screening", `category`: "screening", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "9d7d8eb8ce2494e3e52e49466eac642419e9efa47f98841c836e4826c4f94289", `support_quotes`: ["Bạn nên đăng ký khám Nội tiết để được tư vấn làm các xét nghiệm để làm rõ chẩn đoán."]}},
{`key`: "bc9cea01798e92613d7aba27|SBA261DF565", `properties`: {`kind`: "document", `label`: "Hb và HbA1C là gì và sử dụng để làm gì?", `id`: "SBA261DF565", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về xét nghiệm và sàng lọc đái tháo đường. Trích đoạn từ bài gốc: “Hemoglobin A (HbA) : là loại thường gặp ở người trưởng thành.”", `section`: "Xét nghiệm và sàng lọc đái tháo đường", `topic`: "screening", `category`: "screening", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "77bb90edf73eefeca68910acf354c63f071b2b581cc62bf7ebff6c62d34c062c", `support_quotes`: ["Hemoglobin A (HbA) : là loại thường gặp ở người trưởng thành."]}},
{`key`: "bc9cea01798e92613d7aba27|SBAFB140E23", `properties`: {`kind`: "document", `label`: "Warning Signs and Symptoms of Diabetes", `id`: "SBAFB140E23", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về tổng quan đái tháo đường. Trích đoạn từ bài gốc: “However, some people with diabetes have symptoms so mild that they go unnoticed.”", `section`: "Tổng quan đái tháo đường", `topic`: "overview", `category`: "overview", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "557dc34e1a56f96e4269b40e1384175a92346332b76615f16095c168bd050e19", `support_quotes`: ["However, some people with diabetes have symptoms so mild that they go unnoticed."]}},
{`key`: "bc9cea01798e92613d7aba27|SBB55417BFC", `properties`: {`kind`: "document", `label`: "13 biến chứng tiểu đường nguy hiểm và cách phòng ngừa hiệu quả", `id`: "SBB55417BFC", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về nguy cơ và phòng ngừa đái tháo đường. Trích đoạn từ bài gốc: “Tiểu đường biến chứng qua gan : Gan nhiễm mỡ không do rượu, sỏi mật, xơ gan.”", `section`: "Nguy cơ và phòng ngừa đái tháo đường", `topic`: "prevention", `category`: "prevention", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "f1c0255a748c331a56ffe393052e9820e23e37182084a48bcd843375299f37f7", `support_quotes`: ["Tiểu đường biến chứng qua gan : Gan nhiễm mỡ không do rượu, sỏi mật, xơ gan."]}},
{`key`: "bc9cea01798e92613d7aba27|SBC080382AF", `properties`: {`kind`: "document", `label`: "Bệnh nhân đái tháo đường nên biết tiêm insulin cho phù hợp", `id`: "SBC080382AF", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “Tuy nhiên nếu tiêm insulin không đúng kỹ thuật sẽ gây nguy hiểm cho người bệnh.”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "97944131588b8866c8485edcb001f64e85840c4d79574db660effd1ca342a44e", `support_quotes`: ["Tuy nhiên nếu tiêm insulin không đúng kỹ thuật sẽ gây nguy hiểm cho người bệnh."]}},
{`key`: "bc9cea01798e92613d7aba27|SBD0AB397CA", `properties`: {`kind`: "document", `label`: "Common questions about biphasic insulin - Brand names: Humalog Mix 25, Humalog Mix 50, Humulin M3, NovoMix 30", `id`: "SBD0AB397CA", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “Biphasic insulin is a mixture of a rapid-acting or short-acting insulin and an intermediate-acting insulin in fixed proportions.”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "8898368afe2f62ed7d44d3c7160d777e625dd41e6969b7a02c62ffee515d8629", `support_quotes`: ["Biphasic insulin is a mixture of a rapid-acting or short-acting insulin and an intermediate-acting insulin in fixed proportions."]}},
{`key`: "bc9cea01798e92613d7aba27|SBD0F8C4694", `properties`: {`kind`: "document", `label`: "5 cách điều trị loét do tiểu đường an toàn theo các mức độ bệnh", `id`: "SBD0F8C4694", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về dinh dưỡng và đái tháo đường. Trích đoạn từ bài gốc: “Điều trị toàn thân: Kiểm soát đường huyết: duy trì đường huyết ổn định để hỗ trợ lành vết thương.”", `section`: "Dinh dưỡng và đái tháo đường", `topic`: "nutrition", `category`: "nutrition", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "4ddd71b29ca40e7ec48d38f94df67853ef4b39de7244db0fd4b7d184020d2c6f", `support_quotes`: ["Điều trị toàn thân: Kiểm soát đường huyết: duy trì đường huyết ổn định để hỗ trợ lành vết thương."]}},
{`key`: "bc9cea01798e92613d7aba27|SBE19CF99C1", `properties`: {`kind`: "document", `label`: "Khám bàn chân đái tháo đường có nên không? Khám ở đâu uy tín?", `id`: "SBE19CF99C1", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về chăm sóc bàn chân. Trích đoạn từ bài gốc: “Dấu hiệu nhiễm trùng bàn chân tiểu đường : da trên bàn chân đỏ, ấm hoặc đau.”", `section`: "Chăm sóc bàn chân", `topic`: "feet", `category`: "feet", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "9222bd41ecd7c8398a7cf91c5027f6e0e9264209ac84c0c69d9cb8d2cc6e7a2b", `support_quotes`: ["Dấu hiệu nhiễm trùng bàn chân tiểu đường : da trên bàn chân đỏ, ấm hoặc đau."]}},
{`key`: "bc9cea01798e92613d7aba27|SBE6FEAF582", `properties`: {`kind`: "document", `label`: "Dấu hiệu suy thận ở bệnh nhân tiểu đường", `id`: "SBE6FEAF582", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về bệnh thận do đái tháo đường. Trích đoạn từ bài gốc: “Khi bị suy thận, nồng độ nitơ-urê trong máu (BUN) sẽ tăng cùng lúc với nồng độ Creatinine trong máu.”", `section`: "Bệnh thận do đái tháo đường", `topic`: "kidney", `category`: "kidney", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "c4a73e9af185780b8e4fc80458db1285b27118196696df1326b9c5d8548a82a6", `support_quotes`: ["Khi bị suy thận, nồng độ nitơ-urê trong máu (BUN) sẽ tăng cùng lúc với nồng độ Creatinine trong máu."]}},
{`key`: "bc9cea01798e92613d7aba27|SBEEEAD25D2", `properties`: {`kind`: "document", `label`: "Preventing Diabetes Problems", `id`: "SBEEEAD25D2", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về nguy cơ và phòng ngừa đái tháo đường. Trích đoạn từ bài gốc: “Diabetes can cause nerve damage and poor blood flow, which can lead to serious foot problems.”", `section`: "Nguy cơ và phòng ngừa đái tháo đường", `topic`: "prevention", `category`: "prevention", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "f9d34e220d33acef9cc9a3e78921a335c0de4ae9acd5aac6aaeeb65ed393c9ce", `support_quotes`: ["Diabetes can cause nerve damage and poor blood flow, which can lead to serious foot problems."]}},
{`key`: "bc9cea01798e92613d7aba27|SC0D29BE78E", `properties`: {`kind`: "document", `label`: "Tác dụng phụ khi dùng insulin điều trị tiểu đường", `id`: "SC0D29BE78E", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “Hạ đường huyết là tác dụng phụ của insulin không mong muốn hay gặp nhất.”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "62bea75af5c95caaa96a845d4b4fe978193a8a421c8f14e843fb5f667bdb71d7", `support_quotes`: ["Hạ đường huyết là tác dụng phụ của insulin không mong muốn hay gặp nhất."]}},
{`key`: "bc9cea01798e92613d7aba27|SC12F241AD5", `properties`: {`kind`: "document", `label`: "Cách chăm sóc bàn chân tiểu đường: 10 nguyên tắc cần nhớ", `id`: "SC12F241AD5", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về chăm sóc bàn chân. Trích đoạn từ bài gốc: “Biến chứng bàn chân tiểu đường có thể phòng ngừa nếu biết cách chăm sóc bàn chân tiểu đường tốt.”", `section`: "Chăm sóc bàn chân", `topic`: "feet", `category`: "feet", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "daa877d368a0f589154348d27904ff16e6b75080ec7e1988ac8c99d04de26bec", `support_quotes`: ["Biến chứng bàn chân tiểu đường có thể phòng ngừa nếu biết cách chăm sóc bàn chân tiểu đường tốt."]}},
{`key`: "bc9cea01798e92613d7aba27|SC28159CED0", `properties`: {`kind`: "document", `label`: "Tầm soát tiểu đường thai kỳ", `id`: "SC28159CED0", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Tiểu đường thai kỳ là tình trạng rối loạn dung nạp đường huyết xuất hiện trong thời gian mang thai và thường không có biểu hiện rõ ràng. Việc thực hiện tầm soát và xét nghiệm định kỳ giúp phát hiện sớm bệnh, từ đó có biện pháp can thiệp kịp thời nhằm bảo vệ sức khỏe cho cả mẹ và thai nhi.", `section`: "Tầm soát tiểu đường thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-21", `source_sha256`: "6c2e4f5d9ea6b7aafb65e31a685b87c789293449322f9514dd1e151332469d67", `support_quotes`: ["Tiểu đường thai kỳ là tình trạng rối loạn dung"]}},
{`key`: "bc9cea01798e92613d7aba27|SC41C3A3028", `properties`: {`kind`: "document", `label`: "Các xét nghiệm theo dõi khi mắc đái tháo đường?", `id`: "SC41C3A3028", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về xét nghiệm và sàng lọc đái tháo đường. Trích đoạn từ bài gốc: “Các xét nghiệm đánh giá các rối loạn cùng mắc với đái đường: Mỡ máu, acid uric.”", `section`: "Xét nghiệm và sàng lọc đái tháo đường", `topic`: "screening", `category`: "screening", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "ae0fc62ddc7f8fbeccf72045fb58519cdd9185a5145d52983a5a6086440d3c3b", `support_quotes`: ["Các xét nghiệm đánh giá các rối loạn cùng mắc với đái đường: Mỡ máu, acid uric."]}},
{`key`: "bc9cea01798e92613d7aba27|SCB21C428F7", `properties`: {`kind`: "document", `label`: "Chế độ dinh dưỡng cho thai phụ bị tiểu đường thai kỳ?", `id`: "SCB21C428F7", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “Em khám và được chẩn đoán là tiểu đường thai kỳ.”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "e373e104af40bcfd0ef60fcf7f15d125e4541df4ebf657c03e00819702e52f14", `support_quotes`: ["Em khám và được chẩn đoán là tiểu đường thai kỳ."]}},
{`key`: "bc9cea01798e92613d7aba27|SCD4FE5FD3F", `properties`: {`kind`: "document", `label`: "With prediabetes, action is the best medicine.", `id`: "SCD4FE5FD3F", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “There are no clear symptoms of prediabetes so you may have it and not know it.”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "68654f90bd3ff86ad23864817dbf4c183b881dbda30f0fb0ec357d1065eb939b", `support_quotes`: ["There are no clear symptoms of prediabetes so you may have it and not know it."]}},
{`key`: "bc9cea01798e92613d7aba27|SCE0609C709", `properties`: {`kind`: "document", `label`: "Pregnancy, breastfeeding and fertility while taking short-acting insulin - Brand names: Actrapid, Humulin S", `id`: "SCE0609C709", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “You can take short-acting insulin while you're pregnant.”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "4a7ecb2ca0561165c19e97622c4f56a720c409b9c2163b2156710801c0cf7100", `support_quotes`: ["You can take short-acting insulin while you're pregnant."]}},
{`key`: "bc9cea01798e92613d7aba27|SCEFBA385C2", `properties`: {`kind`: "document", `label`: "Đái tháo đường ở trẻ em: Nguyên nhân, dấu hiệu và cách chẩn đoán", `id`: "SCEFBA385C2", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường ở trẻ em. Trích đoạn từ bài gốc: “Về lâu, tình trạng này có thể hình thành đái tháo đường ở trẻ em.”", `section`: "Đái tháo đường ở trẻ em", `topic`: "pediatrics", `category`: "pediatrics", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "a55dfb081f0b05aec87e10606ee2d15d308777a1e83b1801164f2cf6b8c430b9", `support_quotes`: ["Về lâu, tình trạng này có thể hình thành đái tháo đường ở trẻ em."]}},
{`key`: "bc9cea01798e92613d7aba27|SD03647BBEF", `properties`: {`kind`: "document", `label`: "Ăn kiêng ở người bệnh tiểu đường: Những điều cần biết", `id`: "SD03647BBEF", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về dinh dưỡng và đái tháo đường. Trích đoạn từ bài gốc: “Bạn sẽ cần một liều điều chỉnh insulin để ngăn đường trong máu tăng cao hơn nữa.”", `section`: "Dinh dưỡng và đái tháo đường", `topic`: "nutrition", `category`: "nutrition", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "942ce89b7bae157ea42230e292eefb89a2facd3d7dd0975d3bb92d5ea4f9b46c", `support_quotes`: ["Bạn sẽ cần một liều điều chỉnh insulin để ngăn đường trong máu tăng cao hơn nữa."]}},
{`key`: "bc9cea01798e92613d7aba27|SD3E7E19CA8", `properties`: {`kind`: "document", `label`: "Chăm sóc người bệnh đái tháo đường toàn diện: Đừng quên “tấm khiên” tiêm chủng", `id`: "SD3E7E19CA8", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về sinh hoạt và tự quản lý đái tháo đường. Trích đoạn từ bài gốc: “Trước khi tiêm chủng, người bệnh cần được ổn định đường huyết, không có bệnh lý cấp tính, không sốt.”", `section`: "Sinh hoạt và tự quản lý đái tháo đường", `topic`: "lifestyle", `category`: "lifestyle", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "dc6648a6bdedcde35a77eccacb11f2fdff250d813da77e38de3a6886b0ae1716", `support_quotes`: ["Trước khi tiêm chủng, người bệnh cần được ổn định đường huyết, không có bệnh lý cấp tính, không sốt."]}},
{`key`: "bc9cea01798e92613d7aba27|SD48785FB9B", `properties`: {`kind`: "document", `label`: "Sốc insulin ở bệnh nhân tiểu đường ảnh hưởng gì cho sức khỏe?", `id`: "SD48785FB9B", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “Sốc insulin là tình trạng cấp cứu gây nhiều biến chứng nguy hiểm, đặc biệt là hạ đường huyết .”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "6c774f018f4a4fe85c9adb16211d249a86ccae3d720be7947469320c1c055af0", `support_quotes`: ["Sốc insulin là tình trạng cấp cứu gây nhiều biến chứng nguy hiểm, đặc biệt là hạ đường huyết ."]}},
{`key`: "bc9cea01798e92613d7aba27|SD77EA17143", `properties`: {`kind`: "document", `label`: "Understanding Your Insulin Delivery Options", `id`: "SD77EA17143", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “You and your doctor will decide which insulin and delivery method works best for your treatment plan.”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "423f0d388fa406f9f04098d187f1e0a3d6efc002905b0950af3858e65dbdbc44", `support_quotes`: ["You and your doctor will decide which insulin and delivery method works best for your treatment plan."]}},
{`key`: "bc9cea01798e92613d7aba27|SD8A27AB351", `properties`: {`kind`: "document", `label`: "SỰ KIỆN: CHUNG SỐNG KHỎE MẠNH VỚI BỆNH ĐÁI THÁO ĐƯỜNG – TẠI SAO KHÔNG?", `id`: "SD8A27AB351", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về tổng quan đái tháo đường. Trích đoạn từ bài gốc: “Đảm bảo sức khỏe thể chất cho người mắc đái tháo đường – TS.BS .”", `section`: "Tổng quan đái tháo đường", `topic`: "overview", `category`: "overview", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "56fc3d5f395d7deda86670416731a2a0f7075ee991bbf165d223249ffefbcc2c", `support_quotes`: ["Đảm bảo sức khỏe thể chất cho người mắc đái tháo đường – TS.BS ."]}},
{`key`: "bc9cea01798e92613d7aba27|SDAA4EF7225", `properties`: {`kind`: "document", `label`: "Cách kiểm soát đường huyết không dùng thuốc", `id`: "SDAA4EF7225", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “Tiền sử gia đình: Đái tháo đường thai kỳ , rối loạn lipid máu , tăng huyết áp.”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "cf6790f44b3d6c5ff3dcaf96a53bfe6be44859db97d9340880d87c7a7ad50320", `support_quotes`: ["Tiền sử gia đình: Đái tháo đường thai kỳ , rối loạn lipid máu , tăng huyết áp."]}},
{`key`: "bc9cea01798e92613d7aba27|SDAD4F0E7CC", `properties`: {`kind`: "document", `label`: "Có cần dùng thuốc bổ xương khớp cho người tiểu đường?", `id`: "SDAD4F0E7CC", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “Đối với người bệnh tiểu đường có chỉ định sử dụng glucocorticoids tiêm khớp c ần phải thận trọng.”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "4fef3e6e2d8574dfe70726e66c99a0f7295cdebfe73cb90a73bceac0b6b78bb2", `support_quotes`: ["Đối với người bệnh tiểu đường có chỉ định sử dụng glucocorticoids tiêm khớp c ần phải thận trọng."]}},
{`key`: "bc9cea01798e92613d7aba27|SDF0CA0ED31", `properties`: {`kind`: "document", `label`: "Bệnh da thường gặp ở bệnh nhân đái tháo đường", `id`: "SDF0CA0ED31", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về tổng quan đái tháo đường. Trích đoạn từ bài gốc: “Đái tháo đường không chỉ ảnh hưởng đến tim, thận, mắt mà còn gây ra nhiều tổn thương trên da.”", `section`: "Tổng quan đái tháo đường", `topic`: "overview", `category`: "overview", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "c05d5eab177d4942d83dc605f91e2cfef28d380cb9ff1649989bfc047e24b954", `support_quotes`: ["Đái tháo đường không chỉ ảnh hưởng đến tim, thận, mắt mà còn gây ra nhiều tổn thương trên da."]}},
{`key`: "bc9cea01798e92613d7aba27|SDFAA8A528B", `properties`: {`kind`: "document", `label`: "Bệnh nhân tiểu đường tuýp 1 có uống được ngũ cốc không?", `id`: "SDFAA8A528B", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về dinh dưỡng và đái tháo đường. Trích đoạn từ bài gốc: “Phù hợp với thói quen ăn uống (food habit) của bệnh nhân.”", `section`: "Dinh dưỡng và đái tháo đường", `topic`: "nutrition", `category`: "nutrition", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "96da915ac8013127ffec249f4642f6120d4652c3225a72389117c78806b87d13", `support_quotes`: ["Phù hợp với thói quen ăn uống (food habit) của bệnh nhân."]}},
{`key`: "bc9cea01798e92613d7aba27|SDFEDCEC9DE", `properties`: {`kind`: "document", `label`: "Hướng dẫn chăm sóc vết thương cho người tiểu đường mau lành", `id`: "SDFEDCEC9DE", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về sinh hoạt và tự quản lý đái tháo đường. Trích đoạn từ bài gốc: “Thay băng theo hướng dẫn của bác sĩ Nội tiết – Đái tháo đường.”", `section`: "Sinh hoạt và tự quản lý đái tháo đường", `topic`: "lifestyle", `category`: "lifestyle", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "e112d83acc624b5c9a7db4d4afe7085c524ae7d38bf1208c7d63a27ec35dc893", `support_quotes`: ["Thay băng theo hướng dẫn của bác sĩ Nội tiết – Đái tháo đường."]}},
{`key`: "bc9cea01798e92613d7aba27|SE102F85C94", `properties`: {`kind`: "document", `label`: "Bệnh tiểu đường có ảnh hưởng phát hiện nhồi máu cơ tim không?", `id`: "SE102F85C94", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về biến chứng tim mạch. Trích đoạn từ bài gốc: “Phát hiện và điều trị sớm là yếu tố quan trọng nhất trong tiên lượng lâu dài của bệnh.”", `section`: "Biến chứng tim mạch", `topic`: "heart", `category`: "heart", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "bdca931a8a0311208ac70069cb55c51c7190e42e9e41e1e6245fd471095aa1dc", `support_quotes`: ["Phát hiện và điều trị sớm là yếu tố quan trọng nhất trong tiên lượng lâu dài của bệnh."]}},
{`key`: "bc9cea01798e92613d7aba27|SE32BC2EDEF", `properties`: {`kind`: "document", `label`: "Diabetes Eye Disease", `id`: "SE32BC2EDEF", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về võng mạc đái tháo đường. Trích đoạn từ bài gốc: “Early diabetes-related eye disease often occurs before your vision is affected or you notice symptoms.”", `section`: "Võng mạc đái tháo đường", `topic`: "eyes", `category`: "eyes", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "3eaf2d311e3a87d90649824a92d7b88eeae53912eb7a542b822b653e5626feab", `support_quotes`: ["Early diabetes-related eye disease often occurs before your vision is affected or you notice symptoms."]}},
{`key`: "bc9cea01798e92613d7aba27|SE352A86FDA", `properties`: {`kind`: "document", `label`: "Chăm sóc vết loét ở chân cho bệnh nhân tiểu đường thế nào để mau lành?", `id`: "SE352A86FDA", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về sinh hoạt và tự quản lý đái tháo đường. Trích đoạn từ bài gốc: “Hiện tại mẹ em bị lở loét ở các kẽ ngón chân.”", `section`: "Sinh hoạt và tự quản lý đái tháo đường", `topic`: "lifestyle", `category`: "lifestyle", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "8ff7c3caf0ac018f642fdab2e1096070b45c152e6049b12abcd3a33b8be09872", `support_quotes`: ["Hiện tại mẹ em bị lở loét ở các kẽ ngón chân."]}},
{`key`: "bc9cea01798e92613d7aba27|SE64BCEE043", `properties`: {`kind`: "document", `label`: "Hiểu biết về bệnh tim mạch do xơ vữa ở người đái tháo đường típ 2", `id`: "SE64BCEE043", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về biến chứng tim mạch. Trích đoạn từ bài gốc: “Bệnh mạch máu não gồm có đột quỵ nhồi máu não, xuất huyết não và cơn thoáng thiếu máu não.”", `section`: "Biến chứng tim mạch", `topic`: "heart", `category`: "heart", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "6e89d1d0df07c8a3b8fc66748a76bc5e5f712f3fe8eda9ccce4828360a867d6b", `support_quotes`: ["Bệnh mạch máu não gồm có đột quỵ nhồi máu não, xuất huyết não và cơn thoáng thiếu máu não."]}},
{`key`: "bc9cea01798e92613d7aba27|SE68ADEAEBE", `properties`: {`kind`: "document", `label`: "Cách cấp cứu khi bị hạ đường huyết đột ngột", `id`: "SE68ADEAEBE", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về hạ đường huyết. Trích đoạn từ bài gốc: “Đa phần chúng ta thường nghĩ rằng hạ đường huyết chỉ gặp khi đói .”", `section`: "Hạ đường huyết", `topic`: "hypoglycemia", `category`: "hypoglycemia", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "1e14e68ef930287006df0bbbb9829e90b43d7cec5e557976073dee9dec7ae6c6", `support_quotes`: ["Đa phần chúng ta thường nghĩ rằng hạ đường huyết chỉ gặp khi đói ."]}},
{`key`: "bc9cea01798e92613d7aba27|SE78BDCE260", `properties`: {`kind`: "document", `label`: "Đường huyết thai kỳ 8.22 mmol/l có ảnh hưởng đến thai nhi không?", `id`: "SE78BDCE260", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “Bệnh lý tiểu đường trong thai kỳ sẽ ảnh hưởng đến em bé tùy mức độ.”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "8ee17f7da9255f9cec5e577b0ce2332816ee36a86adb30cc75d9a7e649c1c5d0", `support_quotes`: ["Bệnh lý tiểu đường trong thai kỳ sẽ ảnh hưởng đến em bé tùy mức độ."]}},
{`key`: "bc9cea01798e92613d7aba27|SEADC814102", `properties`: {`kind`: "document", `label`: "Metformin: Thuốc điều trị bệnh tiểu đường loại 2", `id`: "SEADC814102", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “Metformin không điều trị nguyên nhân cơ bản của bệnh tiểu đường.”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "3a60600b50500bd36b4adedaa3c628e28a912eda8f039038d836e558e8c549ab", `support_quotes`: ["Metformin không điều trị nguyên nhân cơ bản của bệnh tiểu đường."]}},
{`key`: "bc9cea01798e92613d7aba27|SEBC4694C21", `properties`: {`kind`: "document", `label`: "Nguy cơ cắt cụt chân do đái tháo đường cần nhận biết sớm", `id`: "SEBC4694C21", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về nguy cơ và phòng ngừa đái tháo đường. Trích đoạn từ bài gốc: “Trên đây là các thông tin về những dấu hiệu cắt cụt chân do đái tháo đường .”", `section`: "Nguy cơ và phòng ngừa đái tháo đường", `topic`: "prevention", `category`: "prevention", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "16d2e58f14f23d444dd9f80d2831f327e772abf0407a229a5d223fb25081bb4a", `support_quotes`: ["Trên đây là các thông tin về những dấu hiệu cắt cụt chân do đái tháo đường ."]}},
{`key`: "bc9cea01798e92613d7aba27|SEBDD751428", `properties`: {`kind`: "document", `label`: "Dinh dưỡng cho người tiểu đường", `id`: "SEBDD751428", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Chế độ dinh dưỡng khoa học đóng vai trò nền tảng trong việc hỗ trợ kiểm soát đường huyết và nâng cao sức khỏe cho người bệnh tiểu đường. Nguyên tắc ăn uống hợp lý bao gồm việc cung cấp đầy đủ các nhóm chất thiết yếu, chia nhỏ bữa ăn và tuân thủ tư vấn từ chuyên gia dinh dưỡng.", `section`: "Dinh dưỡng cho người tiểu đường", `topic`: "nutrition", `category`: "nutrition", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-21", `source_sha256`: "e4f889fcec9e5428124e3a75c07433b707bae63a465dc3deb6fb43c246c5a62d", `support_quotes`: ["Mục tiêu dinh dưỡng cho người tiểu đường là:"]}},
{`key`: "bc9cea01798e92613d7aba27|SEC29581179", `properties`: {`kind`: "document", `label`: "Bệnh gout và tiểu đường: Những mối liên hệ có thể bạn chưa biết", `id`: "SEC29581179", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về tổng quan đái tháo đường. Trích đoạn từ bài gốc: “Điều này góp phần quan trọng trong phòng ngừa các vấn đề liên quan đến gout và đái tháo đường.”", `section`: "Tổng quan đái tháo đường", `topic`: "overview", `category`: "overview", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "1ea3c542aa70208ddf6d4bb964bdec7b000857f687d7d536735ba79aa7b8ce58", `support_quotes`: ["Điều này góp phần quan trọng trong phòng ngừa các vấn đề liên quan đến gout và đái tháo đường."]}},
{`key`: "bc9cea01798e92613d7aba27|SEDD917BF66", `properties`: {`kind`: "document", `label`: "Statistics About Diabetes", `id`: "SEDD917BF66", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về tổng quan đái tháo đường. Trích đoạn từ bài gốc: “To learn more about the statistics presented, view the CDC National Diabetes Statistics Report .”", `section`: "Tổng quan đái tháo đường", `topic`: "overview", `category`: "overview", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "f59dda5365bee54a7aa51e3cb0030654816a9ce8e3d7316b1081a0340c6edc6e", `support_quotes`: ["To learn more about the statistics presented, view the CDC National Diabetes Statistics Report ."]}},
{`key`: "bc9cea01798e92613d7aba27|SEF09FB72D4", `properties`: {`kind`: "document", `label`: "Hướng dẫn cách dùng và lưu ý sử dụng thuốc điều trị đái tháo đường nhóm Biguanide (Metformin)", `id`: "SEF09FB72D4", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “Metformin là thuốc điều trị đái tháo đường nhóm Biguanid đang được sử dụng rất nhiều hiện nay.”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "1b3a1c328696b47633169f92b1ae8f126076def9173c48122e2a76ea8948fd19", `support_quotes`: ["Metformin là thuốc điều trị đái tháo đường nhóm Biguanid đang được sử dụng rất nhiều hiện nay."]}},
{`key`: "bc9cea01798e92613d7aba27|SEF4E320592", `properties`: {`kind`: "document", `label`: "5 cách chữa nóng rát bàn chân ở người bị tiểu đường bạn có biết", `id`: "SEF4E320592", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về chăm sóc bàn chân. Trích đoạn từ bài gốc: “Và việc thiếu máu chứa oxy đến chân cũng làm cho vết thương chậm lành, dễ hoại tử chân.”", `section`: "Chăm sóc bàn chân", `topic`: "feet", `category`: "feet", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "4b9780ca922def5bd2c880cc3ee1665c0e4908ce134f9efbfeb6d57ca26d7c89", `support_quotes`: ["Và việc thiếu máu chứa oxy đến chân cũng làm cho vết thương chậm lành, dễ hoại tử chân."]}},
{`key`: "bc9cea01798e92613d7aba27|SEFB69D55D3", `properties`: {`kind`: "document", `label`: "Đái tháo đường thai kỳ, mối bận tâm của mẹ bầu?", `id`: "SEFB69D55D3", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “Nguy cơ cao huyết áp: Mẹ bầu có nguy cơ cao hơn mắc huyết áp cao trong thai kỳ.”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "9b4834d9d8472ab1a3e8201784d0c37e00af6aa63b59655941d361874ca11768", `support_quotes`: ["Nguy cơ cao huyết áp: Mẹ bầu có nguy cơ cao hơn mắc huyết áp cao trong thai kỳ."]}},
{`key`: "bc9cea01798e92613d7aba27|SF26BF7884A", `properties`: {`kind`: "document", `label`: "Pregnancy, breastfeeding and fertility while taking biphasic insulin - Brand names: Humalog Mix 25, Humalog Mix 50, Humulin M3, NovoMix 30", `id`: "SF26BF7884A", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “You may need less insulin while breastfeeding than you did in pregnancy.”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "e4b96f5742080cd7d5c38c6d31e892594ea53d9aa135576a38310e8910962755", `support_quotes`: ["You may need less insulin while breastfeeding than you did in pregnancy."]}},
{`key`: "bc9cea01798e92613d7aba27|SF26DA3F3A7", `properties`: {`kind`: "document", `label`: "Chẩn đoán đái tháo đường type 2", `id`: "SF26DA3F3A7", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về xét nghiệm và sàng lọc đái tháo đường. Trích đoạn từ bài gốc: “Xét nghiệm đường huyết ngẫu nhiên, thực hiện ngẫu nhiên để chẩn đoán bệnh tiểu đường.”", `section`: "Xét nghiệm và sàng lọc đái tháo đường", `topic`: "screening", `category`: "screening", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "1543cf8a67eaae52f54d8bca9098055849c1b09972a94158819cfc2a7c101740", `support_quotes`: ["Xét nghiệm đường huyết ngẫu nhiên, thực hiện ngẫu nhiên để chẩn đoán bệnh tiểu đường."]}},
{`key`: "bc9cea01798e92613d7aba27|SF47937473B", `properties`: {`kind`: "document", `label`: "Chỉ số đường huyết bao nhiêu là bị tiểu đường thai kỳ?", `id`: "SF47937473B", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “Thai phụ sẽ nhận được kết quả xét nghiệm dung nạp đường huyết khi mang thai ngay sau đó.”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "12c7f63bec616f39bc23af6fc1fbc5cb586344084070bfc77a8ca92082da0e6d", `support_quotes`: ["Thai phụ sẽ nhận được kết quả xét nghiệm dung nạp đường huyết khi mang thai ngay sau đó."]}},
{`key`: "bc9cea01798e92613d7aba27|SF48ACC181C", `properties`: {`kind`: "document", `label`: "Live Cooking Classes", `id`: "SF48ACC181C", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về tổng quan đái tháo đường. Trích đoạn từ bài gốc: “That’s why the American Diabetes Association® (ADA) offers free, live virtual cooking classes powered by Homemade.”", `section`: "Tổng quan đái tháo đường", `topic`: "overview", `category`: "overview", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "55e4a99046dc2029b770fd74eb54d978a98a07bea94fa7d46b3f5b5a0a70b0c5", `support_quotes`: ["That’s why the American Diabetes Association® (ADA) offers free, live virtual cooking classes powered by Homemade."]}},
{`key`: "bc9cea01798e92613d7aba27|SF4DB73C61E", `properties`: {`kind`: "document", `label`: "Loét bàn chân do tiểu đường có nguy hiểm không?", `id`: "SF4DB73C61E", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về chăm sóc bàn chân. Trích đoạn từ bài gốc: “Loét bàn chân là một trong nhiều biến chứng của bệnh tiểu đường, có nguy cơ đoạn chi.”", `section`: "Chăm sóc bàn chân", `topic`: "feet", `category`: "feet", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "d4956d6d97aebeedfd25fc2cde233730afaa21c66179024a78e6a7f039d36001", `support_quotes`: ["Loét bàn chân là một trong nhiều biến chứng của bệnh tiểu đường, có nguy cơ đoạn chi."]}},
{`key`: "bc9cea01798e92613d7aba27|SF55F1986BA", `properties`: {`kind`: "document", `label`: "Ăn cơm khi mắc bệnh tiểu đường và tim mạch", `id`: "SF55F1986BA", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về biến chứng tim mạch. Trích đoạn từ bài gốc: “Bạn cũng nên đảm bảo rằng cơ thể mình chỉ tiêu thụ một phần nhỏ cơm.”", `section`: "Biến chứng tim mạch", `topic`: "heart", `category`: "heart", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "753e5890e626c4a35ddacdd4f4012f1575e2c61c860db47e7feb4dd5d56d84fb", `support_quotes`: ["Bạn cũng nên đảm bảo rằng cơ thể mình chỉ tiêu thụ một phần nhỏ cơm."]}},
{`key`: "bc9cea01798e92613d7aba27|SF6342BB6FF", `properties`: {`kind`: "document", `label`: "Managing Ketones with Diabetes", `id`: "SF6342BB6FF", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về sinh hoạt và tự quản lý đái tháo đường. Trích đoạn từ bài gốc: “Ketones can develop and build up any time your body doesn’t have enough insulin or needs more than usual.”", `section`: "Sinh hoạt và tự quản lý đái tháo đường", `topic`: "lifestyle", `category`: "lifestyle", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "7d77c46dfa7cd7c7339867c32d3f54cdae95c7be5eb0ef8bf913386d15ba0837", `support_quotes`: ["Ketones can develop and build up any time your body doesn’t have enough insulin or needs more than usual."]}},
{`key`: "bc9cea01798e92613d7aba27|SF65C22545C", `properties`: {`kind`: "document", `label`: "Ảnh hưởng của hạ đường huyết lên chất lượng cuộc sống  của bệnh nhân và gia đình", `id`: "SF65C22545C", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về hạ đường huyết. Trích đoạn từ bài gốc: “Những cơn hạ đường huyết có thể ảnh hưởng tới chất lượng công việc.”", `section`: "Hạ đường huyết", `topic`: "hypoglycemia", `category`: "hypoglycemia", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "4f5840b663d792a77055b0888d0d32931db7733f3f786947f351ccc4299b0357", `support_quotes`: ["Những cơn hạ đường huyết có thể ảnh hưởng tới chất lượng công việc."]}},
{`key`: "bc9cea01798e92613d7aba27|SF6F19DCD58", `properties`: {`kind`: "document", `label`: "Đái tháo đường và Nguy cơ tim mạch– là khảo sát trên toàn cầu do Liên đoàn đái tháo đường thế giới (IDF) thực hiện", `id`: "SF6F19DCD58", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về biến chứng tim mạch. Trích đoạn từ bài gốc: “Xin cảm ơn quý vị đã dành thời gian để hoàn tất cuộc khảo sát này.”", `section`: "Biến chứng tim mạch", `topic`: "heart", `category`: "heart", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "f0bbafe84584abdf9945f32a5488ccc283f89a5bba38983d959c2b4ec3015bb7", `support_quotes`: ["Xin cảm ơn quý vị đã dành thời gian để hoàn tất cuộc khảo sát này."]}},
{`key`: "bc9cea01798e92613d7aba27|SF72ADBE5EC", `properties`: {`kind`: "document", `label`: "Hướng dẫn làm đế giày cho người tiểu đường bị biến chứng bàn chân", `id`: "SF72ADBE5EC", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về chăm sóc bàn chân. Trích đoạn từ bài gốc: “Quan sát bàn chân để phát hiện vết chai, loét, nứt nẻ hoặc biến dạng.”", `section`: "Chăm sóc bàn chân", `topic`: "feet", `category`: "feet", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "1a657adf3c436e539cf749390bc9a0518d14515a8366036e01143a8a7a9aa1bc", `support_quotes`: ["Quan sát bàn chân để phát hiện vết chai, loét, nứt nẻ hoặc biến dạng."]}},
{`key`: "bc9cea01798e92613d7aba27|SF971661E15", `properties`: {`kind`: "document", `label`: "Chỉ số đường huyết khi đói 9.8mmol/l, khi no 11.9 mmol/l có phải uống thuốc không?", `id`: "SF971661E15", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “Ngoài ra, em phải thực hiện chế độ ăn kiêng, năng vận động và uống thuốc đái đường.”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "f8c200bf8999116400fd83c81d6c0bd167dfcd1e0a084378856798984969c040", `support_quotes`: ["Ngoài ra, em phải thực hiện chế độ ăn kiêng, năng vận động và uống thuốc đái đường."]}},
{`key`: "bc9cea01798e92613d7aba27|SFC4D928283", `properties`: {`kind`: "document", `label`: "Know the Diabetes-Cancer Link", `id`: "SFC4D928283", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về tổng quan đái tháo đường. Trích đoạn từ bài gốc: “Gender –Overall, cancer occurs more often in men.”", `section`: "Tổng quan đái tháo đường", `topic`: "overview", `category`: "overview", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "b118d60364fcc709a978e6c43aec76559576caeccd39af9f4f06893c22d84ee5", `support_quotes`: ["Gender –Overall, cancer occurs more often in men."]}},
{`key`: "bc9cea01798e92613d7aba27|SFDDBF6D76F", `properties`: {`kind`: "document", `label`: "Hạ đường huyết trên bệnh nhân đái tháo đường – Cập nhật định nghĩa, phân loại theo Hội Đái tháo đường Hoa Kỳ 2022", `id`: "SFDDBF6D76F", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về hạ đường huyết. Trích đoạn từ bài gốc: “Các thuốc này, đặc biệt là insulin là các nguyên nhân gây HĐH thường gặp nhất.”", `section`: "Hạ đường huyết", `topic`: "hypoglycemia", `category`: "hypoglycemia", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "be346275407fc8fb0447b49eea40aee40f596e0241f0147d3da088293678da4d", `support_quotes`: ["Các thuốc này, đặc biệt là insulin là các nguyên nhân gây HĐH thường gặp nhất."]}},
{`key`: "bc9cea01798e92613d7aba27|SFE9E965784", `properties`: {`kind`: "document", `label`: "Bệnh tăng huyết áp và kháng insulin liên quan thế nào?", `id`: "SFE9E965784", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “Kháng insulin và tăng huyết áp là các thành phần của hội chứng chuyển hóa và thường cùng tồn tại.”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "0ee9209b787e77fee7ab2c11571381f9674ce209e11b4f8e4e29dbc595791288", `support_quotes`: ["Kháng insulin và tăng huyết áp là các thành phần của hội chứng chuyển hóa và thường cùng tồn tại."]}},
{`key`: "bc9cea01798e92613d7aba27|V01", `properties`: {`kind`: "document", `label`: "Khái niệm đái tháo đường theo Bộ Y tế", `id`: "V01", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Theo cổng thông tin của Cục Quản lý Khám, chữa bệnh – Bộ Y tế, đái tháo đường là nhóm rối loạn chuyển hóa khiến glucose trong máu tăng do cơ thể tiết insulin không đủ, insulin hoạt động không hiệu quả hoặc cả hai cơ chế cùng tồn tại. Đường huyết tăng kéo dài có thể gây hại nhiều cơ quan, gồm hệ tim mạch, thận, mắt và thần kinh. Đây là thông tin khái quát về cơ chế và hậu quả của bệnh.", `section`: "Khái niệm đái tháo đường theo Bộ Y tế", `topic`: "overview", `category`: "overview", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-06", `source_sha256`: "fd46092bd9d0d18602f1edc2cd36c725a1ecd2c3fbafce2d9a07f594989ff90c", `support_quotes`: ["khiếm khuyết về tiết insulin"]}},
{`key`: "bc9cea01798e92613d7aba27|V02", `properties`: {`kind`: "document", `label`: "Yếu tố nguy cơ đái tháo đường theo Bộ Y tế", `id`: "V02", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Cổng thông tin của Bộ Y tế liệt kê các yếu tố liên quan đến nguy cơ đái tháo đường típ 2 như có người thân mắc bệnh, từng mắc đái tháo đường thai kỳ, lớn tuổi, thừa cân, ít vận động, tăng huyết áp và ăn uống thiếu lành mạnh. Rối loạn dung nạp glucose cũng là yếu tố cần lưu ý: đường huyết đã cao hơn bình thường nhưng chưa đạt mức chẩn đoán đái tháo đường. Các yếu tố này giúp nhận biết nguy cơ, không phải kết luận một người đã mắc bệnh.", `section`: "Yếu tố nguy cơ đái tháo đường theo Bộ Y tế", `topic`: "prevention", `category`: "prevention", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-06", `source_sha256`: "298094f85bd98b7e93abe343466769e6ac2b588247abd4085ed92bd71ca7c88b", `support_quotes`: ["Tiền sử đái tháo đường thai kỳ"]}}] AS row MERGE (n:KBNode:Document {kb_key: row.key}) SET n += row.properties;

UNWIND [{`key`: "bc9cea01798e92613d7aba27|V03", `properties`: {`kind`: "document", `label`: "Ăn uống phòng đái tháo đường típ 2 theo Bộ Y tế", `id`: "V03", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Trong bài về phòng bệnh, cổng thông tin Bộ Y tế nhấn mạnh phối hợp ăn uống lành mạnh và tăng vận động để giảm nguy cơ đái tháo đường típ 2. Các lựa chọn được gợi ý gồm uống nước thay đồ uống nhiều đường, dùng trái cây tươi hoặc sữa chua không đường cho bữa phụ, tăng rau và chọn ngũ cốc nguyên cám. Nguồn cũng khuyên hạn chế đồ uống có cồn, ưu tiên thịt nạc, gia cầm hoặc hải sản thay thịt chế biến sẵn.", `section`: "Ăn uống phòng đái tháo đường típ 2 theo Bộ Y tế", `topic`: "nutrition", `category`: "nutrition", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-06", `source_sha256`: "6d057850cad12af958971e9d2ddc32b95b3044c7a05ac519f681742273e08c1e", `support_quotes`: ["Hạn chế đồ uống có cồn"]}},
{`key`: "bc9cea01798e92613d7aba27|V04", `properties`: {`kind`: "document", `label`: "Vận động phòng đái tháo đường theo Bộ Y tế", `id`: "V04", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Cổng thông tin Bộ Y tế giới thiệu đi bộ là hình thức vận động dễ thực hiện, với tổng thời gian tham khảo 150 phút mỗi tuần, đồng thời đề cập tập kháng lực. Người lớn tuổi hoặc đau khớp có thể chia thành các lượt tập ngắn trong ngày. Trước khi tập, người mắc đái tháo đường cần được đánh giá các vấn đề tim mạch, mắt, thần kinh và bàn chân. Vì vậy, lựa chọn hoạt động cần tính đến sức khỏe và biến chứng của từng người.", `section`: "Vận động phòng đái tháo đường theo Bộ Y tế", `topic`: "activity", `category`: "activity", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-06", `source_sha256`: "769883bdb2fd7878923cc569a2423b336ba591ce574245b98c8a04b99b0b0947", `support_quotes`: ["Mỗi tuần nên tập kháng lực"]}},
{`key`: "bc9cea01798e92613d7aba27|V05", `properties`: {`kind`: "document", `label`: "Nhận biết nguy cơ hạ đường huyết từ cổng thông tin Bộ Y tế", `id`: "V05", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Bài viết của bác sĩ Bệnh viện Lão khoa Trung ương trên cổng thông tin Bộ Y tế mô tả hạ đường huyết ở người đái tháo đường là khi glucose máu dưới 3,9 mmol/L, tương đương 70 mg/dL. Bỏ bữa, thay đổi thuốc, tăng vận động không phù hợp với điều trị, lạm dụng rượu hoặc suy thận có thể làm tăng nguy cơ. Biểu hiện có thể gồm đói, run, vã mồ hôi, chóng mặt hoặc thay đổi hành vi; có người không có dấu hiệu báo trước. Cần đo đường huyết để xác nhận tình trạng này.", `section`: "Nhận biết nguy cơ hạ đường huyết từ cổng thông tin Bộ Y tế", `topic`: "hypoglycemia", `category`: "hypoglycemia", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-06", `source_sha256`: "5239a760bbfb1686f49d029229e18bd500b2803e1094450b88ac1a74d1f7de7f", `support_quotes`: ["chế độ ăn không đều đặn hoặc bỏ bữa"]}},
{`key`: "bc9cea01798e92613d7aba27|V06", `properties`: {`kind`: "document", `label`: "Dinh dưỡng cho người đái tháo đường tại Bệnh viện Bạch Mai", `id`: "V06", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Trong chương trình tư vấn tại Bệnh viện Bạch Mai, người đái tháo đường được hướng dẫn ăn nhiều loại thực phẩm, điều chỉnh lượng tinh bột và tăng chất xơ. Gạo lứt hoặc gạo xát dối là các ví dụ được nêu. Có thể thay đổi cơm sang món khác cùng nhóm như bún, phở, ngô hoặc khoai nhưng vẫn cần tính lượng ăn. Việc cân thực phẩm được thực hành theo cân nặng, chiều cao và tình trạng bệnh của từng người; không lấy khẩu phần của người khác áp dụng nguyên vẹn.", `section`: "Dinh dưỡng cho người đái tháo đường tại Bệnh viện Bạch Mai", `topic`: "nutrition", `category`: "nutrition", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-06", `source_sha256`: "0e09881f83f1004ae1863ce503330d508b56f82db69eb3d23a7410ead5ad9b6b", `support_quotes`: ["kiểm soát đủ lượng tinh bột"]}}] AS row MERGE (n:KBNode:Document {kb_key: row.key}) SET n += row.properties;

