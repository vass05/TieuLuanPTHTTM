UNWIND [{`key`: "bc9cea01798e92613d7aba27|D01", `properties`: {`kind`: "document", `label`: "Bệnh tiểu đường là gì?", `id`: "D01", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Tiểu đường liên quan đến lượng glucose trong máu cao. Insulin giúp glucose đi vào tế bào. Các loại tiểu đường có nguyên nhân khác nhau; thông tin giáo dục không thay thế đánh giá của nhân viên y tế.", `page`: null, `section`: "Khái niệm", `content_type`: "manually_reviewed_vietnamese_paraphrase", `reviewed_on`: "2026-10-31"}},
{`key`: "bc9cea01798e92613d7aba27|D02", `properties`: {`kind`: "document", `label`: "Triệu chứng và nguyên nhân", `id`: "D02", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Các biểu hiện có thể gặp gồm khát nhiều, tiểu nhiều, mệt, nhìn mờ và vết thương chậm lành. Một số người có triệu chứng nhẹ hoặc không nhận thấy. Cần trao đổi với nhân viên y tế về việc xét nghiệm.", `page`: null, `section`: "Symptoms", `content_type`: "manually_reviewed_vietnamese_paraphrase", `reviewed_on`: "2026-10-31"}},
{`key`: "bc9cea01798e92613d7aba27|D03", `properties`: {`kind`: "document", `label`: "Xét nghiệm và chẩn đoán", `id`: "D03", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nhân viên y tế sử dụng các xét nghiệm máu để đánh giá tiểu đường, gồm A1C, glucose huyết tương lúc đói và nghiệm pháp dung nạp glucose. Không tự chẩn đoán chỉ từ máy đo tại nhà hoặc điểm dự đoán của mô hình nghiên cứu.", `page`: null, `section`: "Blood tests", `content_type`: "manually_reviewed_vietnamese_paraphrase", `reviewed_on`: "2026-10-31"}},
{`key`: "bc9cea01798e92613d7aba27|D04", `properties`: {`kind`: "document", `label`: "Theo dõi A1C và kế hoạch chăm sóc", `id`: "D04", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "A1C phản ánh mức glucose trung bình trong khoảng ba tháng. Kế hoạch chăm sóc được thống nhất với đội ngũ y tế, bao gồm theo dõi glucose, huyết áp và cholesterol. Mục tiêu cần được cá thể hóa.", `page`: null, `section`: "Diabetes ABCs / A1C", `content_type`: "manually_reviewed_vietnamese_paraphrase", `reviewed_on`: "2026-10-31"}},
{`key`: "bc9cea01798e92613d7aba27|D05", `properties`: {`kind`: "document", `label`: "Lựa chọn thực phẩm", `id`: "D05", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Các nhóm thực phẩm có thể đưa vào kế hoạch ăn cho người tiểu đường gồm:\n• Rau ít tinh bột, ngũ cốc nguyên hạt, đậu và trái cây với khẩu phần phù hợp.\n• Nguồn đạm như cá, thịt nạc, đậu phụ; sữa hoặc sản phẩm thay thế phù hợp.\n• Nước lọc và đồ uống ít hoặc không thêm đường.\nHạn chế đồ uống có đường, thực phẩm nhiều đường thêm, muối và chất béo bão hòa. Thực phẩm chứa carbohydrate vẫn cần tính đến lượng ăn. Khẩu phần nên được cá thể hóa cùng nhân viên y tế, nhất là khi có bệnh kèm.", `page`: null, `section`: "How can I plan what to eat or drink when I have diabetes? / Choose healthy foods and drinks", `content_type`: "manually_reviewed_vietnamese_paraphrase", `reviewed_on`: "2026-10-31"}},
{`key`: "bc9cea01798e92613d7aba27|D06", `properties`: {`kind`: "document", `label`: "Vận động và lối sống", `id`: "D06", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Hoạt động thể chất hỗ trợ quản lý tiểu đường và sức khỏe tổng thể. Lựa chọn hình thức vận động phù hợp, tăng dần theo khả năng và trao đổi với đội ngũ chăm sóc khi cần điều chỉnh kế hoạch.", `page`: null, `section`: "Physical activity", `content_type`: "manually_reviewed_vietnamese_paraphrase", `reviewed_on`: "2026-10-31"}},
{`key`: "bc9cea01798e92613d7aba27|D07", `properties`: {`kind`: "document", `label`: "Phòng ngừa tiểu đường tuýp 2", `id`: "D07", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Với người có nguy cơ, thay đổi lối sống có thể giúp phòng ngừa hoặc trì hoãn tiểu đường tuýp 2. Những nội dung cần trao đổi gồm cân nặng, ăn uống và vận động; không phải mọi yếu tố nguy cơ đều có thể thay đổi.", `page`: null, `section`: "Prevention", `content_type`: "manually_reviewed_vietnamese_paraphrase", `reviewed_on`: "2026-10-31"}},
{`key`: "bc9cea01798e92613d7aba27|D08", `properties`: {`kind`: "document", `label`: "Thông tin về hạ đường huyết", `id`: "D08", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Hạ đường huyết xảy ra khi glucose thấp hơn mức phù hợp với người bệnh. Biểu hiện có thể gồm run, đói, chóng mặt hoặc lú lẫn. Tình trạng nặng có thể cần người khác hỗ trợ; kế hoạch xử trí phải được thống nhất với nhân viên y tế.", `page`: null, `section`: "Symptoms / severe low glucose", `content_type`: "manually_reviewed_vietnamese_paraphrase", `reviewed_on`: "2026-10-31"}},
{`key`: "bc9cea01798e92613d7aba27|D09", `properties`: {`kind`: "document", `label`: "Xét nghiệm theo dõi thận", `id`: "D09", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Đánh giá bệnh thận có thể sử dụng xét nghiệm máu ước tính mức lọc cầu thận và xét nghiệm albumin trong nước tiểu. Bệnh thận giai đoạn sớm có thể chưa có triệu chứng. Người có tiểu đường cần trao đổi về lịch kiểm tra thận.", `page`: null, `section`: "CKD tests / GFR and albumin", `content_type`: "manually_reviewed_vietnamese_paraphrase", `reviewed_on`: "2026-10-31"}},
{`key`: "bc9cea01798e92613d7aba27|D10", `properties`: {`kind`: "document", `label`: "Thuốc và trao đổi với đội ngũ chăm sóc", `id`: "D10", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Lựa chọn thuốc điều trị phụ thuộc loại tiểu đường và tình trạng sức khỏe. Cần trao đổi với đội ngũ y tế về thuốc đang dùng, tác dụng không mong muốn và cách dùng. Hệ thống thực nghiệm chỉ cung cấp thông tin tham khảo.", `page`: null, `section`: "Treatment choices", `content_type`: "manually_reviewed_vietnamese_paraphrase", `reviewed_on`: "2026-10-31"}},
{`key`: "bc9cea01798e92613d7aba27|K01", `properties`: {`kind`: "document", `label`: "Tiểu đường tuýp 2 là gì?", `id`: "K01", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Tiểu đường tuýp 2 là tình trạng đường huyết cao vì cơ thể sử dụng insulin kém hiệu quả hoặc không tạo đủ insulin. Insulin giúp glucose vào tế bào để tạo năng lượng. Khi quá trình này bị rối loạn, glucose tích tụ trong máu.\nBệnh thường gặp ở người trưởng thành nhưng trẻ em cũng có thể mắc. Kiểm soát bệnh phối hợp ăn uống, vận động, quản lý cân nặng, theo dõi và thuốc khi được chỉ định. Cần xét nghiệm để xác định bệnh; không thể kết luận chỉ qua triệu chứng.", `section`: "Tiểu đường tuýp 2 là gì?", `topic`: "type2", `content_type`: "manually_reviewed_vietnamese_paraphrase", `reviewed_on`: "2026-10-31"}},
{`key`: "bc9cea01798e92613d7aba27|K02", `properties`: {`kind`: "document", `label`: "Tiểu đường tuýp 1 và sự khác biệt với tuýp 2", `id`: "K02", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Tiểu đường tuýp 1 xảy ra khi hệ miễn dịch phá hủy các tế bào tạo insulin của tụy, khiến cơ thể tạo rất ít hoặc không còn insulin. Người mắc thường cần insulin hằng ngày để sống và kiểm soát đường huyết.\nKhác với cơ chế đề kháng insulin thường gặp ở tuýp 2, tuýp 1 có cơ chế tự miễn. Chế độ ăn và vận động hỗ trợ chăm sóc nhưng không thay thế insulin đã được kê. Bác sĩ có thể cần thêm xét nghiệm để phân biệt loại bệnh.", `section`: "Tiểu đường tuýp 1 và sự khác biệt với tuýp 2", `topic`: "type1", `content_type`: "manually_reviewed_vietnamese_paraphrase", `reviewed_on`: "2026-10-31"}},
{`key`: "bc9cea01798e92613d7aba27|K03", `properties`: {`kind`: "document", `label`: "Tiền tiểu đường và kháng insulin", `id`: "K03", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Tiền tiểu đường nghĩa là đường huyết cao hơn bình thường nhưng chưa đến mức chẩn đoán tiểu đường tuýp 2. Kháng insulin là tình trạng cơ thể đáp ứng với insulin kém hơn bình thường.\nTiền tiểu đường làm tăng nguy cơ mắc tuýp 2, nhưng không phải ai cũng tiến triển thành bệnh. Ăn uống phù hợp, hoạt động thể chất và quản lý cân nặng cùng đội ngũ y tế có thể giúp giảm nguy cơ. Nhiều người không có triệu chứng rõ nên cần xét nghiệm và theo dõi.", `section`: "Tiền tiểu đường và kháng insulin", `topic`: "prediabetes", `content_type`: "manually_reviewed_vietnamese_paraphrase", `reviewed_on`: "2026-10-31"}},
{`key`: "bc9cea01798e92613d7aba27|K04", `properties`: {`kind`: "document", `label`: "Tiểu đường thai kỳ", `id`: "K04", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Tiểu đường thai kỳ là tiểu đường xuất hiện trong thời gian mang thai, thường được phát hiện khoảng tuần 24–28. Đường huyết cao có thể ảnh hưởng mẹ và bé, như em bé quá lớn hoặc bị hạ đường huyết sau sinh.\nViệc theo dõi và kiểm soát đường huyết cần phối hợp với đội ngũ sản khoa và chuyên khoa tiểu đường. Không áp dụng máy móc chế độ ăn hoặc thuốc của người khác cho thai phụ.", `section`: "Tiểu đường thai kỳ", `topic`: "pregnancy", `content_type`: "manually_reviewed_vietnamese_paraphrase", `reviewed_on`: "2026-10-31"}},
{`key`: "bc9cea01798e92613d7aba27|K05", `properties`: {`kind`: "document", `label`: "Người tiểu đường có uống rượu bia được không?", `id`: "K05", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Người tiểu đường cần thận trọng với rượu bia; không thể khẳng định ai cũng uống được an toàn. Rượu có thể làm đường huyết tăng hoặc giảm và tương tác với thuốc. Nguy cơ hạ đường huyết đáng chú ý khi dùng insulin hoặc một số thuốc tiểu đường, nhất là uống lúc đói; nguy cơ có thể kéo dài nhiều giờ sau uống.\nHãy hỏi bác sĩ dựa trên thuốc đang dùng, mức kiểm soát đường huyết và bệnh kèm. Nếu được phép uống, không uống lúc đói và cần kế hoạch theo dõi đường huyết. Không coi biểu hiện lú lẫn hoặc buồn ngủ sau uống chỉ là say rượu.", `section`: "Người tiểu đường có uống rượu bia được không?", `topic`: "alcohol", `content_type`: "manually_reviewed_vietnamese_paraphrase", `reviewed_on`: "2026-10-31"}},
{`key`: "bc9cea01798e92613d7aba27|K06", `properties`: {`kind`: "document", `label`: "Nước cam, nước ép, mật ong và đồ uống ngọt", `id`: "K06", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nước cam và các nước ép vẫn có đường; không thêm đường không có nghĩa là không làm tăng đường huyết. Nước ép, mật ong và siro là nguồn carbohydrate đơn có thể làm đường huyết tăng nhanh. Hạn chế đồ uống ngọt trong chế độ ăn thường ngày, chú ý lượng carbohydrate và khẩu phần.\nTrái cây nguyên quả có chất xơ và dưỡng chất. Việc chọn đồ uống cần tính cả lượng uống và kế hoạch ăn của bạn.", `section`: "Nước cam, nước ép, mật ong và đồ uống ngọt", `topic`: "juice", `content_type`: "manually_reviewed_vietnamese_paraphrase", `reviewed_on`: "2026-10-31"}},
{`key`: "bc9cea01798e92613d7aba27|K07", `properties`: {`kind`: "document", `label`: "Cơm, bún, phở và carbohydrate", `id`: "K07", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Người tiểu đường không nhất thiết phải bỏ hết tinh bột. Cần lựa chọn nguồn carbohydrate và khẩu phần phù hợp. Gạo trắng, bánh mì trắng và ngũ cốc tinh chế có ít chất xơ hơn ngũ cốc nguyên hạt.\nKhi ăn cơm hoặc món tinh bột, hãy tính lượng carbohydrate của cả bữa. Không có một khẩu phần chung phù hợp cho tất cả mọi người.", `section`: "Cơm, bún, phở và carbohydrate", `topic`: "rice", `content_type`: "manually_reviewed_vietnamese_paraphrase", `reviewed_on`: "2026-10-31"}},
{`key`: "bc9cea01798e92613d7aba27|K08", `properties`: {`kind`: "document", `label`: "Trái cây, sữa, đậu và lựa chọn thực phẩm", `id`: "K08", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Trái cây có thể là một phần của chế độ ăn cho người tiểu đường; vẫn cần tính khẩu phần và carbohydrate. ADA gợi ý nhóm thực phẩm giàu dưỡng chất như rau lá xanh, đậu, cá, các loại hạt, quả mọng, trái cây họ cam quýt, ngũ cốc nguyên hạt, sữa và sữa chua ít béo.\nMột thực phẩm được gọi là “siêu thực phẩm” không có nghĩa là chữa được tiểu đường. Lựa chọn cần phù hợp tổng thể bữa ăn và bệnh kèm; không suy ra rằng có thể ăn không giới hạn.", `section`: "Trái cây, sữa, đậu và lựa chọn thực phẩm", `topic`: "fruit", `content_type`: "manually_reviewed_vietnamese_paraphrase", `reviewed_on`: "2026-10-31"}},
{`key`: "bc9cea01798e92613d7aba27|K09", `properties`: {`kind`: "document", `label`: "Chăm sóc bàn chân và vết thương", `id`: "K09", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Tiểu đường có thể gây tổn thương thần kinh và giảm tuần hoàn ở chân, khiến vết thương khó lành hoặc khó được nhận ra. Kiểm tra bàn chân mỗi ngày, giữ sạch và khô, mang giày vừa chân và tránh đi chân đất.\nNếu có vết loét, sưng đỏ, nhiễm trùng hoặc vết thương không lành, cần liên hệ nhân viên y tế sớm. Không tự xử lý chai chân bằng hóa chất hoặc cắt sâu vào da.", `section`: "Chăm sóc bàn chân và vết thương", `topic`: "feet", `content_type`: "manually_reviewed_vietnamese_paraphrase", `reviewed_on`: "2026-10-31"}},
{`key`: "bc9cea01798e92613d7aba27|K10", `properties`: {`kind`: "document", `label`: "Biến chứng mắt và khám võng mạc", `id`: "K10", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Bệnh mắt do tiểu đường có thể gồm bệnh võng mạc, phù hoàng điểm, đục thủy tinh thể và tăng nhãn áp. Tổn thương ban đầu có thể chưa gây triệu chứng, vì vậy không nên chờ nhìn mờ mới khám.\nKhám mắt có giãn đồng tử giúp phát hiện sớm. Kiểm soát đường huyết, huyết áp và cholesterol hỗ trợ bảo vệ mắt; lịch khám cụ thể cần trao đổi với bác sĩ mắt.", `section`: "Biến chứng mắt và khám võng mạc", `topic`: "eyes", `content_type`: "manually_reviewed_vietnamese_paraphrase", `reviewed_on`: "2026-10-31"}},
{`key`: "bc9cea01798e92613d7aba27|K100", `properties`: {`kind`: "document", `label`: "Phòng ngừa đái tháo đường thai kỳ", `id`: "K100", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguy cơ mắc đái tháo đường thai kỳ tăng lên nếu phụ nữ từng mắc bệnh trước đây, có tiền sử gia đình bị đái tháo đường tuýp 2, bị tiền đái tháo đường hoặc hội chứng buồng trứng đa nang. Phụ nữ thừa cân dự định mang thai có thể giảm nguy cơ bằng cách giảm cân và tăng cường vận động.", `section`: "Phòng ngừa đái tháo đường thai kỳ", `topic`: "gestational_diabetes_prevention", `category`: "pregnancy", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-10-31", `source_sha256`: "60c01bfd56c7b1a251eaa77ef7b9ae19049426f1f6715d176ad110007e5c7c6f", `support_quotes`: ["Your chance of developing gestational diabetes are higher",
"If you are thinking about becoming pregnant and"]}},
{`key`: "bc9cea01798e92613d7aba27|K101", `properties`: {`kind`: "document", `label`: "Triệu chứng và nguyên nhân đái tháo đường thai kỳ", `id`: "K101", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Đái tháo đường thai kỳ thường không có triệu chứng hoặc có các dấu hiệu nhẹ như khát nước và đi tiểu nhiều hơn bình thường. Nguyên nhân là do cơ thể không thể sản xuất đủ lượng insulin bổ sung cần thiết trong giai đoạn thai kỳ để vượt qua tình trạng kháng insulin.", `section`: "Triệu chứng và nguyên nhân đái tháo đường thai kỳ", `topic`: "gestational_diabetes_causes", `category`: "pregnancy", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-10-31", `source_sha256`: "2c7d70a445e608941532f7b20ee7d06c007bb0d7abda51bcd901a4ce06aacbc5", `support_quotes`: ["If you do have symptoms, they may be",
