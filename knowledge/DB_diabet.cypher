{`key`: "bc9cea01798e92613d7aba27|PFE0D48F5CD30", `properties`: {`kind`: "document", `label`: "Nhận xét tình trạng rối loạn dung nạp glucose ở bệnh nhân có nguy cơ mắc bệnh đái tháo đường típ 2 tại Bệnh viện Đại học Y Thái Bình", `id`: "PFE0D48F5CD30", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nghiên cứu về nguy cơ và phòng ngừa. Phạm vi và kết quả chi tiết có trong bài gốc. Trích trang 2 của PDF gốc (tiếng Anh) “The risk of diabetes and impaired glucose tolerance increased with an increased number of diabetes risks in the same patient (p <0.05)”.", `page`: 2, `section`: "Trích đoạn nhận diện qua văn bản", `topic`: "risk", `content_type`: "attributed_original_pdf_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "1d83b84fefa019d52a9ed01bf7c4903fefcc6a217ff46183c2df66708c7dd2f9", `support_quotes`: ["The risk of diabetes and impaired glucose tolerance increased with an increased number of diabetes risks in the same patient (p <0.05)"]}},
{`key`: "bc9cea01798e92613d7aba27|S000F567C6B", `properties`: {`kind`: "document", `label`: "Chỉ số đường huyết ở người tiểu đường thai kỳ tăng nên làm gì?", `id`: "S000F567C6B", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “Bạn cần khám chuyên khoa Nội tiết để kiểm soát đường huyết tốt hơn, tránh biến chứng.”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "bd4f7b044a6e109705ce1e9ddbf4b5bff23b4639a6fb1bde00009f068217c43a", `support_quotes`: ["Bạn cần khám chuyên khoa Nội tiết để kiểm soát đường huyết tốt hơn, tránh biến chứng."]}},
{`key`: "bc9cea01798e92613d7aba27|S0183D059E2", `properties`: {`kind`: "document", `label`: "Thực phẩm tốt và không tốt cho bệnh nhân đái tháo đường", `id`: "S0183D059E2", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về dinh dưỡng và đái tháo đường. Trích đoạn từ bài gốc: “- Tránh tăng đường huyết quá mức do không biết chọn thực phẩm.”", `section`: "Dinh dưỡng và đái tháo đường", `topic`: "nutrition", `category`: "nutrition", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "3bf372c2a4a6c2efcf1de89ca67f1279f0f81bfad0287d48cda7aae1627945bc", `support_quotes`: ["- Tránh tăng đường huyết quá mức do không biết chọn thực phẩm."]}},
{`key`: "bc9cea01798e92613d7aba27|S01C0CDCED6", `properties`: {`kind`: "document", `label`: "Phác đồ điều trị đái tháo đường thai kỳ?", `id`: "S01C0CDCED6", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “Đái tháo đường thai khi nếu không được phát hiện sớm sẽ ảnh hưởng đến cả mẹ và con.”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "5b80b8d947d2a307567c6213d4b14b1d9b10b304bc39ad98e69d3cea308ed875", `support_quotes`: ["Đái tháo đường thai khi nếu không được phát hiện sớm sẽ ảnh hưởng đến cả mẹ và con."]}},
{`key`: "bc9cea01798e92613d7aba27|S04E9F1BF05", `properties`: {`kind`: "document", `label`: "HbA1Cb: 7%, chỉ số đường huyết lúc đói: 8.5 mmol/L có phải bị tiểu đường không?", `id`: "S04E9F1BF05", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về xét nghiệm và sàng lọc đái tháo đường. Trích đoạn từ bài gốc: “Đường huyết trong máu lúc đói của bạn chưa đạt mục tiêu.”", `section`: "Xét nghiệm và sàng lọc đái tháo đường", `topic`: "screening", `category`: "screening", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "2c9cdc1784e12013fd582de2e2966ff77e04296b605a70a21f8b2a3388288775", `support_quotes`: ["Đường huyết trong máu lúc đói của bạn chưa đạt mục tiêu."]}},
{`key`: "bc9cea01798e92613d7aba27|S0752523387", `properties`: {`kind`: "document", `label`: "Bệnh gan và tiểu đường ảnh hưởng lẫn nhau ra sao?", `id`: "S0752523387", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về tổng quan đái tháo đường. Trích đoạn từ bài gốc: “Bệnh gan và tiểu đường thường song hành với nhau.”", `section`: "Tổng quan đái tháo đường", `topic`: "overview", `category`: "overview", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "d6ed3d94964eb008bfec30d047184afa811ee6bf8b2466394ffede4019b6fd69", `support_quotes`: ["Bệnh gan và tiểu đường thường song hành với nhau."]}},
{`key`: "bc9cea01798e92613d7aba27|S081B42FF6A", `properties`: {`kind`: "document", `label`: "Bàn chân người bệnh tiểu đường bị nổi mủ, sưng phải làm sao?", `id`: "S081B42FF6A", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nhiễm trùng chân là một biến chứng thường gặp ở người bệnh đái tháo đường và gây nhiều khó khăn trong việc điều trị. Người bệnh cần đến bệnh viện để bác sĩ đánh giá tình trạng nhiễm trùng, đường huyết và mạch máu nuôi. Việc ổn định đường huyết, mỡ máu cùng với chăm sóc bàn chân mỗi ngày giúp phát hiện vết thương sớm và ngăn chặn biến chứng.", `section`: "Bàn chân người bệnh tiểu đường bị nổi mủ, sưng phải làm sao?", `topic`: "feet", `category`: "feet", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-21", `source_sha256`: "ab3bece033e45b7cf4d7fbb290467a9e4664744871e48a666a88a45d9f2afdea", `support_quotes`: ["Bệnh Đái tháo đường có thể có rất nhiều biến"]}},
{`key`: "bc9cea01798e92613d7aba27|S090D391BAF", `properties`: {`kind`: "document", `label`: "Rối loạn lipid máu và tiểu đường", `id`: "S090D391BAF", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Rối loạn lipid máu là tình trạng thường gặp ở bệnh nhân đái tháo đường và có mối liên hệ mật thiết với các bệnh lý tim mạch. Việc chẩn đoán sớm thông qua các xét nghiệm chỉ số mỡ máu kết hợp với việc thay đổi lối sống và điều trị đúng cách giúp ngăn ngừa hiệu quả các biến chứng nguy hiểm.", `section`: "Rối loạn lipid máu và tiểu đường", `topic`: "screening", `category`: "screening", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-21", `source_sha256`: "c98bedf6d42a9201935129996ec750250991726c91bf473fb79ae60ad2af5e98", `support_quotes`: ["Rối loạn lipid máu hay gặp ở bệnh nhân đái"]}},
{`key`: "bc9cea01798e92613d7aba27|S0A567B6695", `properties`: {`kind`: "document", `label`: "Food Insecurity and Diabetes", `id`: "S0A567B6695", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về dinh dưỡng và đái tháo đường. Trích đoạn từ bài gốc: “The lack of access to healthy food reflects a larger problem in America: food insecurity.”", `section`: "Dinh dưỡng và đái tháo đường", `topic`: "nutrition", `category`: "nutrition", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "262881a5eeb3e98807c0eba18fe48cd85fc62dbe5e619ce5e06445503dc42c01", `support_quotes`: ["The lack of access to healthy food reflects a larger problem in America: food insecurity."]}},
{`key`: "bc9cea01798e92613d7aba27|S0D35080B9C", `properties`: {`kind`: "document", `label`: "Bệnh tim mạch vành nên ăn gì để giảm cân với chế độ ít chất đường huyết", `id`: "S0D35080B9C", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về biến chứng tim mạch. Trích đoạn từ bài gốc: “Bệnh tim mạch vành thường được gây ra bởi mảng xơ vữa mạch vành.”", `section`: "Biến chứng tim mạch", `topic`: "heart", `category`: "heart", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "7fc9226ede0d1972a9ed648e594ace08a43d54e8e72b8597fc3775a30d570c14", `support_quotes`: ["Bệnh tim mạch vành thường được gây ra bởi mảng xơ vữa mạch vành."]}},
{`key`: "bc9cea01798e92613d7aba27|S0D9347E430", `properties`: {`kind`: "document", `label`: "Các nhóm thuốc điều trị đái tháo đường", `id`: "S0D9347E430", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Đái tháo đường gồm nhiều thể bệnh khác nhau, trong đó đái tháo đường type 1 là bệnh tự miễn do cơ thể không thể tự sản xuất insulin, buộc phải tiêm insulin để duy trì sự sống. Trong khi đó, đái tháo đường type 2 có cơ chế kháng insulin và giảm tiết insulin từ tụy, thường được điều trị bằng các nhóm thuốc uống dạng viên hoặc kết hợp tiêm.", `section`: "Các nhóm thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-21", `source_sha256`: "7874eea3b53b1896f3e6551bd8c4495b3dfe190314697fb65fe72e9e3ca9ff5e", `support_quotes`: ["Đái đường type 1 là bệnh tự miễn , trong"]}},
{`key`: "bc9cea01798e92613d7aba27|S0DFB6B2542", `properties`: {`kind`: "document", `label`: "Các lựa chọn điều trị bằng thuốc mới cho bệnh tiểu đường", `id`: "S0DFB6B2542", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “Đây là dạng kết hợp các loại thuốc metformin và empagliflozin.”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "aadb6c6284f46ee469334111a68bad7cacb23464a9ed6fcb14225b3de833cd08", `support_quotes`: ["Đây là dạng kết hợp các loại thuốc metformin và empagliflozin."]}},
{`key`: "bc9cea01798e92613d7aba27|S0DFF1691E5", `properties`: {`kind`: "document", `label`: "Nên chọn thực phẩm có chỉ số đường huyết thấp an toàn cho bệnh nhân đái tháo đường", `id`: "S0DFF1691E5", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về hạ đường huyết. Trích đoạn từ bài gốc: “Số lượng thực phẩm vừa đủ với nhu cầu của cơ thể sao cho giữ cân nặng hợp lý.”", `section`: "Hạ đường huyết", `topic`: "hypoglycemia", `category`: "hypoglycemia", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "79070b7944e62cd0f82099b399d0c7a4870b40a7f32144e88948bc117cf09bde", `support_quotes`: ["Số lượng thực phẩm vừa đủ với nhu cầu của cơ thể sao cho giữ cân nặng hợp lý."]}},
{`key`: "bc9cea01798e92613d7aba27|S117621F60E", `properties`: {`kind`: "document", `label`: "3 bước đo đường huyết khi thực hiện xét nghiệm dung nạp glucose đường uống", `id`: "S117621F60E", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về xét nghiệm và sàng lọc đái tháo đường. Trích đoạn từ bài gốc: “Trong thời gian người làm xét nghiệm này có thể uống nước lọc nhưng cần hạn chế vận động.”", `section`: "Xét nghiệm và sàng lọc đái tháo đường", `topic`: "screening", `category`: "screening", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "f24aa5f915882ff9dbd15df1bf1bfbd9e8e26599ae5593529b36291049fd3793", `support_quotes`: ["Trong thời gian người làm xét nghiệm này có thể uống nước lọc nhưng cần hạn chế vận động."]}},
{`key`: "bc9cea01798e92613d7aba27|S118930BCC3", `properties`: {`kind`: "document", `label`: "Chỉ số đường huyết sau khi ăn bao nhiêu là bình thường?", `id`: "S118930BCC3", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về dinh dưỡng và đái tháo đường. Trích đoạn từ bài gốc: “Đường huyết ngẫu nhiên : Mẫu máu có thể được lấy vào bất cứ thời điểm nào trong ngày.”", `section`: "Dinh dưỡng và đái tháo đường", `topic`: "nutrition", `category`: "nutrition", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "740daa89b51c9b2d0f4678428af98e86efdd6c79876ff04d3bc0b54c9515bfff", `support_quotes`: ["Đường huyết ngẫu nhiên : Mẫu máu có thể được lấy vào bất cứ thời điểm nào trong ngày."]}},
{`key`: "bc9cea01798e92613d7aba27|S12D7FCCA6E", `properties`: {`kind`: "document", `label`: "Bệnh tiểu đường nên ăn và nên kiêng những gì?", `id`: "S12D7FCCA6E", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về dinh dưỡng và đái tháo đường. Trích đoạn từ bài gốc: “Người bị tiểu đường nên ăn đầy đủ các thành phần dinh dưỡng và không kiêng ăn lạc (đậu phộng).”", `section`: "Dinh dưỡng và đái tháo đường", `topic`: "nutrition", `category`: "nutrition", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "2c4c58e6d11b2469e63d876a0c9b8019175a34c4294a3514ab22189997206105", `support_quotes`: ["Người bị tiểu đường nên ăn đầy đủ các thành phần dinh dưỡng và không kiêng ăn lạc (đậu phộng)."]}},
{`key`: "bc9cea01798e92613d7aba27|S13215CE0C8", `properties`: {`kind`: "document", `label`: "Thuốc điều trị tiểu đường tuýp 2 dùng loại nào phù hợp?", `id`: "S13215CE0C8", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “Thuốc này có thể sử dụng kết hợp với metformin, insulin cơ bản hoặc sulfonylurea.”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "c158df8ccf476fc2605be133eb181e8976e21fea5968345a684bdec8db4cd066", `support_quotes`: ["Thuốc này có thể sử dụng kết hợp với metformin, insulin cơ bản hoặc sulfonylurea."]}},
{`key`: "bc9cea01798e92613d7aba27|S1491715E4A", `properties`: {`kind`: "document", `label`: "HẠ ĐƯỜNG HUYẾT - NGUY CƠ KHÔNG DỄ NHẬN RA", `id`: "S1491715E4A", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về hạ đường huyết. Trích đoạn từ bài gốc: “Khó khăn tiếp theo liên quan đến phương tiện phát hiện hạ đường huyết.”", `section`: "Hạ đường huyết", `topic`: "hypoglycemia", `category`: "hypoglycemia", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "e210180acce9db15dbf48701575ee8d6f8a4e88d006dde1740b0d82a170df749", `support_quotes`: ["Khó khăn tiếp theo liên quan đến phương tiện phát hiện hạ đường huyết."]}},
{`key`: "bc9cea01798e92613d7aba27|S15AD5CA2D5", `properties`: {`kind`: "document", `label`: "Thực phẩm cần tránh khi mắc bệnh tiểu đường", `id`: "S15AD5CA2D5", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Tiêu thụ quá nhiều carbohydrate có thể làm lượng đường huyết tăng cao nguy hiểm. Việc duy trì chế độ ăn ít carbohydrate giúp ngăn ngừa đường huyết tăng đột biến và giảm thiểu nguy cơ biến chứng của bệnh đái tháo đường. Người bệnh nên tránh các loại thực phẩm chứa nhiều carbohydrate, đồ uống có đường và chất béo chuyển hóa để bảo vệ sức khỏe.", `section`: "Thực phẩm cần tránh khi mắc bệnh tiểu đường", `topic`: "nutrition", `category`: "nutrition", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-21", `source_sha256`: "00e7da2b48bea2284836d8bda0b0fcbdd662bbf9520372b72c8c797d5921680d", `support_quotes`: ["Trong số ba chất này, cho đến nay carbs vẫn"]}},
{`key`: "bc9cea01798e92613d7aba27|S16E10D485C", `properties`: {`kind`: "document", `label`: "Insulin và sức mạnh bộ xương", `id`: "S16E10D485C", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “Tác động của Insulin đối với bộ xương đóng vai trò quan trọng trong việc duy trì sức khỏe xương.”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "5a24f36e200ba7dd39213afb0bd67ac1df09186938e5e04069045663abe15baf", `support_quotes`: ["Tác động của Insulin đối với bộ xương đóng vai trò quan trọng trong việc duy trì sức khỏe xương."]}},
{`key`: "bc9cea01798e92613d7aba27|S17958D7507", `properties`: {`kind`: "document", `label`: "Bệnh tiểu đường uống nước gì tốt để ổn định đường huyết?", `id`: "S17958D7507", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về dinh dưỡng và đái tháo đường. Trích đoạn từ bài gốc: “Tuy nhiên, không phải loại nước nào cũng tốt cho người đái tháo đường.”", `section`: "Dinh dưỡng và đái tháo đường", `topic`: "nutrition", `category`: "nutrition", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "1dd561d380bf6a969af70c237d78870e2497fa2758689cb4e38cad15ad1a38b5", `support_quotes`: ["Tuy nhiên, không phải loại nước nào cũng tốt cho người đái tháo đường."]}},
