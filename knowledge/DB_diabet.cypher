{`key`: "bc9cea01798e92613d7aba27|S22F3A142B5", `properties`: {`kind`: "document", `label`: "Prevent or Delay Diabetes", `id`: "S22F3A142B5", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về nguy cơ và phòng ngừa đái tháo đường. Trích đoạn từ bài gốc: “These videos will help you learn how healthy living helps to prevent or delay diabetes.”", `section`: "Nguy cơ và phòng ngừa đái tháo đường", `topic`: "prevention", `category`: "prevention", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "b946045fe10dc0e180a4a3f974c20449ef81db762f63516ec16a252cdfde2d14", `support_quotes`: ["These videos will help you learn how healthy living helps to prevent or delay diabetes."]}},
{`key`: "bc9cea01798e92613d7aba27|S241E6BE6C1", `properties`: {`kind`: "document", `label`: "Giá trị an toàn của chỉ số đường huyết", `id`: "S241E6BE6C1", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về dinh dưỡng và đái tháo đường. Trích đoạn từ bài gốc: “Chỉ số đường huyết là nồng độ glucose có trong máu.”", `section`: "Dinh dưỡng và đái tháo đường", `topic`: "nutrition", `category`: "nutrition", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "8d5b546ba911a592882c8d79e4a4b21a12081b53fecf1fb50a01a6af91b43dc0", `support_quotes`: ["Chỉ số đường huyết là nồng độ glucose có trong máu."]}},
{`key`: "bc9cea01798e92613d7aba27|S2504D0F56D", `properties`: {`kind`: "document", `label`: "Bệnh tiểu đường có bị biến chứng thần kinh ngoại vi hay không?", `id`: "S2504D0F56D", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về bệnh thận do đái tháo đường. Trích đoạn từ bài gốc: “Theo em tìm hiểu các dấu hiệu này giống như biến chứng thần kinh ngoại vi.”", `section`: "Bệnh thận do đái tháo đường", `topic`: "kidney", `category`: "kidney", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "09a920328091816734d75c8ae5f2b11c4966a4ec791b73891f7a89179e6e4ae7", `support_quotes`: ["Theo em tìm hiểu các dấu hiệu này giống như biến chứng thần kinh ngoại vi."]}},
{`key`: "bc9cea01798e92613d7aba27|S2648FA08FB", `properties`: {`kind`: "document", `label`: "Bệnh tiểu đường ảnh hưởng đến thai kỳ như thế nào?", `id`: "S2648FA08FB", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “Phụ nữ mang thai khi bị tiểu đường sẽ gặp phải nhiều vấn đề sức khỏe khác nhau.”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "cdb72fe8c5d7f049b9b646a07d8b884e599b048a0c2385ab46cda8f30458643e", `support_quotes`: ["Phụ nữ mang thai khi bị tiểu đường sẽ gặp phải nhiều vấn đề sức khỏe khác nhau."]}}] AS row MERGE (n:KBNode:Document {kb_key: row.key}) SET n += row.properties;

UNWIND [{`key`: "bc9cea01798e92613d7aba27|S2A2E183166", `properties`: {`kind`: "document", `label`: "Bàn chân Charcot ở bệnh nhân tiểu đường", `id`: "S2A2E183166", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về chăm sóc bàn chân. Trích đoạn từ bài gốc: “Đối với người bệnh mắc đái tháo đường thì biến chứng bàn chân không có cơ chế rõ ràng.”", `section`: "Chăm sóc bàn chân", `topic`: "feet", `category`: "feet", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "aa5ad19712412ec9eaceb650d59e33511e7abdda13d1148e64c2401b12704c74", `support_quotes`: ["Đối với người bệnh mắc đái tháo đường thì biến chứng bàn chân không có cơ chế rõ ràng."]}},
{`key`: "bc9cea01798e92613d7aba27|S2A938BC16E", `properties`: {`kind`: "document", `label`: "Can I get continuous glucose monitoring on the NHS?", `id`: "S2A938BC16E", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về theo dõi đường huyết. Trích đoạn từ bài gốc: “When you scan your CGM sensor, this is known as flash glucose monitoring.”", `section`: "Theo dõi đường huyết", `topic`: "monitoring", `category`: "monitoring", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "0df2172be06b794646d3646458579baa6ed95eb9d4f0b4e2233e3a93a51be957", `support_quotes`: ["When you scan your CGM sensor, this is known as flash glucose monitoring."]}},
{`key`: "bc9cea01798e92613d7aba27|S2AAFD6EA7B", `properties`: {`kind`: "document", `label`: "Quản lý điều trị đái tháo đường", `id`: "S2AAFD6EA7B", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Người bệnh đái tháo đường lớn tuổi kèm theo nhiều bệnh lý đồng mắc đòi hỏi quá trình theo dõi và kiểm soát đường huyết rất cẩn trọng. Việc thay đổi phác đồ điều trị từ tiêm sang thuốc uống hoặc điều chỉnh liều lượng cần phải tuân thủ tuyệt đối chỉ định của bác sĩ chuyên khoa nội tiết để đảm bảo an toàn.", `section`: "Quản lý điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-21", `source_sha256`: "1796e535117f213d487307d208423022655544057ab75231299f0b55ac6dae01", `support_quotes`: ["Trường hợp của bà là một bệnh nhân lớn tuổi"]}},
{`key`: "bc9cea01798e92613d7aba27|S2B7889D8DE", `properties`: {`kind`: "document", `label`: "Oral & Injectable Medications for Type 2 Diabetes", `id`: "S2B7889D8DE", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “There are different types, or classes, of medications that work in different ways to lower blood glucose levels.”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "24d2fe6ec9d120dbaabe1d8b054079224aea0b6662d51ca31f33b0a60ad6dcb1", `support_quotes`: ["There are different types, or classes, of medications that work in different ways to lower blood glucose levels."]}},
{`key`: "bc9cea01798e92613d7aba27|S2C51EB65C0", `properties`: {`kind`: "document", `label`: "Các đối tượng có nguy cơ bị hạ đường huyết sơ sinh", `id`: "S2C51EB65C0", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về hạ đường huyết. Trích đoạn từ bài gốc: “Tuy nhiên, hầu hết các trường hợp này đều không gây nguy hiểm.”", `section`: "Hạ đường huyết", `topic`: "hypoglycemia", `category`: "hypoglycemia", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "e8c8bb18d1500cd9ff3aab1d9c814f9e20d8cc8fbbcae88fe83085b4598a8f06", `support_quotes`: ["Tuy nhiên, hầu hết các trường hợp này đều không gây nguy hiểm."]}},
{`key`: "bc9cea01798e92613d7aba27|S2D76CAA4CF", `properties`: {`kind`: "document", `label`: "Tóm tắt Nghiên cứu về Chi phí y tế trực tiếp cho bệnh đái tháo đường và các biến chứng tại Việt Nam", `id`: "S2D76CAA4CF", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về tổng quan đái tháo đường. Trích đoạn từ bài gốc: “Nghiên cứu được tiến hành dưới quan điểm của nhà chi trả (bảo hiểm y tế).”", `section`: "Tổng quan đái tháo đường", `topic`: "overview", `category`: "overview", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "c54e1040c42e8dd6c202b612db3e7790b3ccb4a8772864718c8c61589f94b29b", `support_quotes`: ["Nghiên cứu được tiến hành dưới quan điểm của nhà chi trả (bảo hiểm y tế)."]}},
{`key`: "bc9cea01798e92613d7aba27|S2F4BB8A015", `properties`: {`kind`: "document", `label`: "Chẩn đoán đái tháo đường tuýp 2", `id`: "S2F4BB8A015", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Đái tháo đường tuýp 2 là bệnh lý rối loạn chuyển hóa mạn tính, được chẩn đoán thông qua các xét nghiệm máu như đo lượng đường huyết hoặc chỉ số HbA1c. Việc duy trì chế độ ăn uống khoa học, tăng cường vận động thể lực và kiểm soát định kỳ giúp người bệnh quản lý hiệu quả lượng đường trong máu, từ đó phòng ngừa các biến chứng nguy hiểm.", `section`: "Chẩn đoán đái tháo đường tuýp 2", `topic`: "screening", `category`: "screening", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-21", `source_sha256`: "0e6a506aeae7a3984bfdb3566523dd0e04bdb1b7829e0c2cd68fc2cf960202e3", `support_quotes`: ["Bệnh tiểu đường type 2 thường được chẩn đoán bằng"]}},
{`key`: "bc9cea01798e92613d7aba27|S30468F6F6B", `properties`: {`kind`: "document", `label`: "Đề kháng insulin và tim mạch", `id`: "S30468F6F6B", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Đề kháng insulin là hiện tượng giảm đáp ứng của tế bào với insulin, dẫn đến tăng nồng độ insulin và đường huyết trong máu. Tình trạng này kéo dài có thể gây ra nhiều vấn đề sức khỏe nghiêm trọng như đái tháo đường tuýp 2 và các bệnh lý tim mạch. Duy trì lối sống lành mạnh giúp cải thiện tình trạng này.", `section`: "Đề kháng insulin và tim mạch", `topic`: "heart", `category`: "heart", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-21", `source_sha256`: "0952202e19c4dfd7c147b59e896f71f8395a69eb05a3ef0b030825cfec0f6f56", `support_quotes`: ["Trước tiên đề kháng insulin dẫn đến tình trạng tăng"]}},
{`key`: "bc9cea01798e92613d7aba27|S3104C83DE0", `properties`: {`kind`: "document", `label`: "Food and Blood Glucose", `id`: "S3104C83DE0", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về dinh dưỡng và đái tháo đường. Trích đoạn từ bài gốc: “Blood glucose highs and lows can be frustrating.”", `section`: "Dinh dưỡng và đái tháo đường", `topic`: "nutrition", `category`: "nutrition", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "219328a841855d9eb03f868efa314936182befa86c3eae7db004565cd47d2515", `support_quotes`: ["Blood glucose highs and lows can be frustrating."]}},
{`key`: "bc9cea01798e92613d7aba27|S315CC6459A", `properties`: {`kind`: "document", `label`: "Insulin là gì? Vai trò, tác dụng phụ, lưu ý khi sử dụng theo hướng dẫn của Bộ Y tế", `id`: "S315CC6459A", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “Các tác dụng phụ khác như dị ứng Insulin khá hiếm gặp trong thời điểm hiện tại.”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "a028130e0ed093eed20c1f974921c032f6404dead6b5f94d9449f98f12d11ccb", `support_quotes`: ["Các tác dụng phụ khác như dị ứng Insulin khá hiếm gặp trong thời điểm hiện tại."]}},
{`key`: "bc9cea01798e92613d7aba27|S3167C14828", `properties`: {`kind`: "document", `label`: "Tiểu đường thai kỳ ảnh hưởng thế nào đến thai nhi? Kiêng khem ra sao?", `id`: "S3167C14828", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “Nếu em làm tốt điều này thì thai nhi sẽ không bị ảnh hưởng gì cả em nhé.”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "2815115dad1f066ba43ce71c66b3c6522b894f370cf7d6bb625bed8b537bc0c8", `support_quotes`: ["Nếu em làm tốt điều này thì thai nhi sẽ không bị ảnh hưởng gì cả em nhé."]}},
{`key`: "bc9cea01798e92613d7aba27|S33713AEEA9", `properties`: {`kind`: "document", `label`: "Tăng cân do tác dụng phụ khi điều trị đái tháo đường, làm thế để khắc phục?", `id`: "S33713AEEA9", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về tổng quan đái tháo đường. Trích đoạn từ bài gốc: “Bác sĩ có thể điều chỉnh thuốc để bạn có cân nặng phù hợp hơn.”", `section`: "Tổng quan đái tháo đường", `topic`: "overview", `category`: "overview", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "ed61322e7f5cd40f601eb658383f9c10ec703ac988b7e83470924ebbe23e8ce8", `support_quotes`: ["Bác sĩ có thể điều chỉnh thuốc để bạn có cân nặng phù hợp hơn."]}},
{`key`: "bc9cea01798e92613d7aba27|S341B61ABE2", `properties`: {`kind`: "document", `label`: "Bí quyết để người tiểu đường du lịch an toàn", `id`: "S341B61ABE2", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Việc du lịch có thể ảnh hưởng đến quá trình quản lý bệnh tiểu đường do thay đổi giờ giấc và chế độ ăn uống. Người bệnh cần tham khảo ý kiến bác sĩ trước chuyến đi, mang theo lượng thuốc gấp đôi, bảo quản insulin đúng cách tránh nhiệt độ cao, đồng thời kiểm tra đường huyết thường xuyên để đảm bảo sức khỏe ổn định suốt hành trình.", `section`: "Bí quyết để người tiểu đường du lịch an toàn", `topic`: "lifestyle", `category`: "lifestyle", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-21", `source_sha256`: "e2e92649b57826d37d1503cc7045833782b1dce32703cabf14cd750dcd3e0c2b", `support_quotes`: ["Việc ăn uống không đúng giờ giấc, thức ăn lạ,"]}},
{`key`: "bc9cea01798e92613d7aba27|S3448A14467", `properties`: {`kind`: "document", `label`: "Bị tiểu đường thai kỳ có cần tiêm insulin để an toàn cho mẹ và bé không?", `id`: "S3448A14467", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Trong cơ thể, các chỉ số glucose luôn dao động theo từng ngày và thời điểm, do đó kết quả đo đường huyết có thể khác nhau giữa các lần. Đối với tiểu đường thai kỳ, mục tiêu chung là duy trì mức glucose đói buổi sáng và sau ăn theo khuyến cáo, đồng thời theo dõi sát sao và khám chuyên khoa nội tiết để được tư vấn điều trị phù hợp.", `section`: "Bị tiểu đường thai kỳ có cần tiêm insulin để an toàn cho mẹ và bé không?", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-21", `source_sha256`: "1247b0bbbebe438822000c4e970acb7afdaec1e8932fa6967b9c207965905725", `support_quotes`: ["Mục tiêu chung là em cần giữ cho glucose đói"]}},
{`key`: "bc9cea01798e92613d7aba27|S348BC9DCB5", `properties`: {`kind`: "document", `label`: "Cách xử trí tăng đường huyết ở người bệnh đái tháo đường", `id`: "S348BC9DCB5", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Tăng đường huyết là tình trạng chỉ số đường glucose vượt mức bình thường, gây ảnh hưởng xấu đến người bệnh tiểu đường. Nguyên nhân có thể do không tuân thủ điều trị, chế độ ăn hoặc bệnh lý kèm theo. Người bệnh cần biết cách xử trí, duy trì lối sống lành mạnh, kiểm soát cân nặng, vận động hợp lý và thăm khám định kỳ để phòng ngừa biến chứng nguy hiểm.", `section`: "Cách xử trí tăng đường huyết ở người bệnh đái tháo đường", `topic`: "hyperglycemia", `category`: "hyperglycemia", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-21", `source_sha256`: "eaff57840cc74e49f432a7ab1cba271301b7de6e9af9218c9eab2b9debc1df24", `support_quotes`: ["Tình trạng đường huyết tăng cao gây ảnh hưởng xấu"]}},
{`key`: "bc9cea01798e92613d7aba27|S3498370F9E", `properties`: {`kind`: "document", `label`: "Mối quan hệ giữa bệnh tiểu đường với insulin", `id`: "S3498370F9E", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “Insulin có ý nghĩa quan trọng trong việc kiểm soát và điều trị bệnh tiểu đường.”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "2bc8ab48121bdddee7f1ab7f27f18affdd7249be7b00c4b4530fbb73bcd85fdb", `support_quotes`: ["Insulin có ý nghĩa quan trọng trong việc kiểm soát và điều trị bệnh tiểu đường."]}},
{`key`: "bc9cea01798e92613d7aba27|S349FAE7056", `properties`: {`kind`: "document", `label`: "Tầm soát tiểu đường thai kỳ là gì và khi nào?", `id`: "S349FAE7056", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “Ngày nay, tỉ lệ bà bầu bị tiểu đường thai kỳ đang có xu hướng ngày càng gia tăng.”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "f28504fc3444977f1071c7bb8b1543765acba213bad52b9a1db52f89ebc99ed7", `support_quotes`: ["Ngày nay, tỉ lệ bà bầu bị tiểu đường thai kỳ đang có xu hướng ngày càng gia tăng."]}},
{`key`: "bc9cea01798e92613d7aba27|S3790026537", `properties`: {`kind`: "document", `label`: "Bệnh tiểu đường phụ thuộc insulin là gì? Làm sao nhận biết sớm?", `id`: "S3790026537", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “Yếu tố tự miễn: Đây là nguyên nhân chính gây ra tình trạng đái tháo đường phụ thuộc vào insulin.”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "d6d84a0a7f9374fe7ed4d833dbf5e77f25b1bbd5ed58ff576018acd8d4116de8", `support_quotes`: ["Yếu tố tự miễn: Đây là nguyên nhân chính gây ra tình trạng đái tháo đường phụ thuộc vào insulin."]}},
{`key`: "bc9cea01798e92613d7aba27|S3A1D1BA8F6", `properties`: {`kind`: "document", `label`: "5 môn thể thao tốt cho bà bầu bị tiểu đường thai kỳ", `id`: "S3A1D1BA8F6", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “Đi bộ là hoạt động rất tốt cho phụ nữ mang thai.”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "b2182d084b975e3fc127d4429d72391b0c39b25e597f992f3e399355ac4db521", `support_quotes`: ["Đi bộ là hoạt động rất tốt cho phụ nữ mang thai."]}},
{`key`: "bc9cea01798e92613d7aba27|S3A9D815827", `properties`: {`kind`: "document", `label`: "Kế hoạch chăm sóc bệnh nhân tiểu đường tuýp 2", `id`: "S3A9D815827", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về sinh hoạt và tự quản lý đái tháo đường. Trích đoạn từ bài gốc: “Béo phì là một trong những nguyên nhân khiến người bệnh dễ mắc bệnh tiểu đường do kháng insulin.”", `section`: "Sinh hoạt và tự quản lý đái tháo đường", `topic`: "lifestyle", `category`: "lifestyle", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "658866204af4f98d71caf0532906ad659cdba1b7c707c40d97f8d2750bb9cf66", `support_quotes`: ["Béo phì là một trong những nguyên nhân khiến người bệnh dễ mắc bệnh tiểu đường do kháng insulin."]}},
{`key`: "bc9cea01798e92613d7aba27|S3BE66D2FB2", `properties`: {`kind`: "document", `label`: "Phụ nữ bị tiểu đường type 1 nếu mang thai con có bị di truyền không?", `id`: "S3BE66D2FB2", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “Bạn cần được tư vấn bởi bác sĩ chuyên khoa Nội tiết trước khi mang thai.”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "f9991ff3d1a9819e1d191aef929d571d51b74c598a22238b9462516410240a6b", `support_quotes`: ["Bạn cần được tư vấn bởi bác sĩ chuyên khoa Nội tiết trước khi mang thai."]}},
{`key`: "bc9cea01798e92613d7aba27|S3CA8EBF1D5", `properties`: {`kind`: "document", `label`: "Lớp đào tạo giảng viên quốc gia về quản lý tăng huyết áp và đái tháo đường theo nguyên lý y học gia đình tại các trạm y tế xã ngày 11-13/6/2018", `id`: "S3CA8EBF1D5", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về tổng quan đái tháo đường. Trích đoạn từ bài gốc: “Vì vậy, lớp tập huấn này có vai trò và ý nghĩa rất quan trọng.”", `section`: "Tổng quan đái tháo đường", `topic`: "overview", `category`: "overview", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "159a24b51356de07edcdbc37214cd455f3a274decad43e128279a2e81f4e8ed1", `support_quotes`: ["Vì vậy, lớp tập huấn này có vai trò và ý nghĩa rất quan trọng."]}},
{`key`: "bc9cea01798e92613d7aba27|S3D0E847376", `properties`: {`kind`: "document", `label`: "Hướng dẫn chẩn đoán và điều trị đái tháo đường típ 2", `id`: "S3D0E847376", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Đái tháo đường là bệnh không lây nhiễm phổ biến toàn cầu với số lượng người mắc gia tăng nhanh chóng theo thời gian. Bệnh gây ra nhiều biến chứng nguy hiểm như tim mạch, mù lòa và suy thận. Bộ Y tế đã ban hành hướng dẫn chẩn đoán và điều trị nhằm chuẩn hóa công tác chuyên môn và hỗ trợ các thầy thuốc trong thực hành lâm sàng.", `section`: "Hướng dẫn chẩn đoán và điều trị đái tháo đường típ 2", `topic`: "screening", `category`: "screening", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-21", `source_sha256`: "b811e2efcaa76af550dd12304ca76d6df80f9a68347770b62beedd29e69bd897", `support_quotes`: ["Đái tháo đường là một trong những bệnh không lây"]}},
{`key`: "bc9cea01798e92613d7aba27|S3F5C7A6FE4", `properties`: {`kind`: "document", `label`: "Insulin Basics for Diabetes", `id`: "S3F5C7A6FE4", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “There are different types of insulin depending on how quickly they work, when they peak and how long they last.”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "33353fd4ae4f19a8eb68292fa9466726a91b494b2512a2ca0eb3921344751b9d", `support_quotes`: ["There are different types of insulin depending on how quickly they work, when they peak and how long they last."]}},
{`key`: "bc9cea01798e92613d7aba27|S408B2B19D9", `properties`: {`kind`: "document", `label`: "Cách chăm sóc bàn chân người bệnh tiểu đường", `id`: "S408B2B19D9", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Biến chứng loét bàn chân là một rủi ro lớn đối với người mắc bệnh đái tháo đường do tổn thương thần kinh ngoại biên và mạch máu. Người bệnh cần tự kiểm tra bàn chân hàng ngày, vệ sinh sạch sẽ, mang giày dép phù hợp để tránh tổn thương, không tự ý xử lý vết thương nặng mà cần đến cơ sở y tế để được điều trị kịp thời.", `section`: "Cách chăm sóc bàn chân người bệnh tiểu đường", `topic`: "feet", `category`: "feet", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-21", `source_sha256`: "0c3e030819a730c9fc8ee5f8a6cea7d0e7c66e018094b92a7cdb018610bae9ef", `support_quotes`: ["Biến chứng tiểu đường có thể là loét bàn chân,"]}},
{`key`: "bc9cea01798e92613d7aba27|S40A26E082E", `properties`: {`kind`: "document", `label`: "Exercise for diabetes", `id`: "S40A26E082E", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về hoạt động thể lực và đái tháo đường. Trích đoạn từ bài gốc: “Help your mind as well as your body - exercise releases endorphins, which you could think of as happy hormones.”", `section`: "Hoạt động thể lực và đái tháo đường", `topic`: "activity", `category`: "activity", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "c2e311e17243685ead16d9f0b0d772f0160e3be5ee5d0f9dabcd41a0fe92a216", `support_quotes`: ["Help your mind as well as your body - exercise releases endorphins, which you could think of as happy hormones."]}},
{`key`: "bc9cea01798e92613d7aba27|S42C6E114A1", `properties`: {`kind`: "document", `label`: "Hình ảnh bàn chân đái tháo đường theo mức độ chi tiết", `id`: "S42C6E114A1", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về chăm sóc bàn chân. Trích đoạn từ bài gốc: “Trên đây là các hình ảnh bàn chân đái tháo đường theo từng mức độ cụ thể.”", `section`: "Chăm sóc bàn chân", `topic`: "feet", `category`: "feet", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "3b097fb26d74013988587ce9f3de7c17ac0c7805c6feea9f532c5e6f570254b7", `support_quotes`: ["Trên đây là các hình ảnh bàn chân đái tháo đường theo từng mức độ cụ thể."]}},
{`key`: "bc9cea01798e92613d7aba27|S434B7313C8", `properties`: {`kind`: "document", `label`: "Chế độ ăn giúp người tiểu đường tăng cân?", `id`: "S434B7313C8", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về dinh dưỡng và đái tháo đường. Trích đoạn từ bài gốc: “Trong thay đổi lối sống sẽ gồm có chế độ dinh dưỡng và chế độ vận động.”", `section`: "Dinh dưỡng và đái tháo đường", `topic`: "nutrition", `category`: "nutrition", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "6a5604cd69b2e6e342d7f88f6e8f2133aab859bb03dfb5654eb1297dd2f36d9d", `support_quotes`: ["Trong thay đổi lối sống sẽ gồm có chế độ dinh dưỡng và chế độ vận động."]}},
{`key`: "bc9cea01798e92613d7aba27|S4420F7C7CE", `properties`: {`kind`: "document", `label`: "Khi nào nên xét nghiệm tiền đái tháo đường?", `id`: "S4420F7C7CE", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về xét nghiệm và sàng lọc đái tháo đường. Trích đoạn từ bài gốc: “Xét nghiệm tiền đái tháo đường là cách hiệu quả nhất để phát hiện bệnh.”", `section`: "Xét nghiệm và sàng lọc đái tháo đường", `topic`: "screening", `category`: "screening", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "6ca5996c9128b12ce35c0f77240aa565b6ae4d24a560efce91e42bcd89406ff2", `support_quotes`: ["Xét nghiệm tiền đái tháo đường là cách hiệu quả nhất để phát hiện bệnh."]}},
{`key`: "bc9cea01798e92613d7aba27|S45C054D58A", `properties`: {`kind`: "document", `label`: "Cao huyết áp kèm tiểu đường có thể mang thai được không?", `id`: "S45C054D58A", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “Bên cạnh đó, tình trạng tăng huyết áp có thể là những hệ quả của bệnh thận hoặc tuyến giáp.”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "1476c1243271a2c846f7c8d7481ec5657c5996e6f2a027117af0b7848da93f94", `support_quotes`: ["Bên cạnh đó, tình trạng tăng huyết áp có thể là những hệ quả của bệnh thận hoặc tuyến giáp."]}},
{`key`: "bc9cea01798e92613d7aba27|S4631DB559F", `properties`: {`kind`: "document", `label`: "Bệnh đái tháo đường: chế độ ăn như thế nào?", `id`: "S4631DB559F", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Chế độ dinh dưỡng cho người bệnh đái tháo đường cần đảm bảo cung cấp đủ năng lượng cân bằng, không làm tăng đường huyết quá mức sau ăn và duy trì hoạt động thể lực bình thường. Khẩu phần ăn nên phân bổ hợp lý các chất bột đường, chất béo, chất đạm, tăng cường chất xơ từ rau củ và hạn chế các thực phẩm nhiều đường.", `section`: "Bệnh đái tháo đường: chế độ ăn như thế nào?", `topic`: "nutrition", `category`: "nutrition", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-21", `source_sha256`: "b2df3ad6cc0fbec1a4be80de2049f40114b477891c35525a357bf15979d4dd39", `support_quotes`: ["- Chất xơ có tác dụng giúp thức ăn ở"]}},
{`key`: "bc9cea01798e92613d7aba27|S465ACAC6B2", `properties`: {`kind`: "document", `label`: "Chẩn đoán tiểu đường thai kỳ như thế nào?", `id`: "S465ACAC6B2", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “Chế độ ăn uống rất quan trọng để bạn kiểm soát đường huyết trong đái tháo đường thai kỳ.”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "bfe40e6880e4b0068c101eb1d1bfea4f0b9c5099782bc80472e9e8bdbb60b1cc", `support_quotes`: ["Chế độ ăn uống rất quan trọng để bạn kiểm soát đường huyết trong đái tháo đường thai kỳ."]}},
{`key`: "bc9cea01798e92613d7aba27|S4726C82F32", `properties`: {`kind`: "document", `label`: "Các biến chứng tim mạch của bệnh tiểu đường", `id`: "S4726C82F32", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về biến chứng tim mạch. Trích đoạn từ bài gốc: “Xơ vữa động mạch và suy tim là các bệnh tim mạch thường gặp ở người bệnh tiểu đường .”", `section`: "Biến chứng tim mạch", `topic`: "heart", `category`: "heart", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "57a129e99c6e88d0d7cf90b162d6ea49db87de07730f7e407839a931ad8da0b2", `support_quotes`: ["Xơ vữa động mạch và suy tim là các bệnh tim mạch thường gặp ở người bệnh tiểu đường ."]}},
{`key`: "bc9cea01798e92613d7aba27|S48BC5F9E06", `properties`: {`kind`: "document", `label`: "Chăm sóc các vấn đề tim mạch ở người bệnh tiểu đường và tiền tiểu đường", `id`: "S48BC5F9E06", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về biến chứng tim mạch. Trích đoạn từ bài gốc: “Người mắc tiền tiểu đường nên được kiểm tra đánh giá lại hằng năm.”", `section`: "Biến chứng tim mạch", `topic`: "heart", `category`: "heart", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "41303ac569fd03f5a44eb3a44dcb138826bc52397acdecdce595957a79c9abc1", `support_quotes`: ["Người mắc tiền tiểu đường nên được kiểm tra đánh giá lại hằng năm."]}},
{`key`: "bc9cea01798e92613d7aba27|S4E76D30AFD", `properties`: {`kind`: "document", `label`: "Hướng dẫn chăm sóc và điều trị bệnh đái tháo đường type 2 ở người cao tuổi", `id`: "S4E76D30AFD", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường ở người cao tuổi. Trích đoạn từ bài gốc: “Kiểm soát tốt glucose máu vẫn là vấn đề cốt lõi trong điều trị đái tháo đường .”", `section`: "Đái tháo đường ở người cao tuổi", `topic`: "older_adults", `category`: "older_adults", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "6e16dc08b30d9df0cf2e8b8315cbc6ff6c7722e185f3a5768132e086330a5dfe", `support_quotes`: ["Kiểm soát tốt glucose máu vẫn là vấn đề cốt lõi trong điều trị đái tháo đường ."]}},
{`key`: "bc9cea01798e92613d7aba27|S4E8A784424", `properties`: {`kind`: "document", `label`: "Theo dõi đường huyết và tư vấn cá nhân hoá", `id`: "S4E8A784424", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Quản lý và điều trị bệnh đái tháo đường đúng cách rất quan trọng để ngăn ngừa các biến chứng nguy hiểm như bệnh tim mạch và suy thận. Việc kiểm soát tốt đường huyết giúp duy trì sức khỏe ổn định và cải thiện chất lượng cuộc sống cho người bệnh.", `section`: "Theo dõi đường huyết và tư vấn cá nhân hoá", `topic`: "monitoring", `category`: "monitoring", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-21", `source_sha256`: "7bd203a0771ba63749873ee089c71e0443bf54a308edc8d3af34e32619cf0d52", `support_quotes`: ["Việc quản lý và điều trị bệnh đái tháo đường"]}},
{`key`: "bc9cea01798e92613d7aba27|S4FE4B7C6FA", `properties`: {`kind`: "document", `label`: "Chế độ ăn Ketogenic đối với bệnh tiểu đường loại 2", `id`: "S4FE4B7C6FA", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về dinh dưỡng và đái tháo đường. Trích đoạn từ bài gốc: “Chế độ ăn Ketogenic có thể làm giảm lượng đường trong máu.”", `section`: "Dinh dưỡng và đái tháo đường", `topic`: "nutrition", `category`: "nutrition", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "38c10ce6b0a2c4b6daefd9e574cb8b38660b93074b6afd55e6888b80a1673598", `support_quotes`: ["Chế độ ăn Ketogenic có thể làm giảm lượng đường trong máu."]}},
{`key`: "bc9cea01798e92613d7aba27|S511B4F2C77", `properties`: {`kind`: "document", `label`: "Chỉ số đường huyết sau ăn 2h là 10.7mmol/L có phải tiểu đường thai kỳ?", `id`: "S511B4F2C77", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “Tôi không hiểu là tuổi thai chuẩn ở đây em nói là dựa theo mốc nào.”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "603caf5f942b0f027488530d2f8b894aa33c9685ed3cdf2691759da0c0744396", `support_quotes`: ["Tôi không hiểu là tuổi thai chuẩn ở đây em nói là dựa theo mốc nào."]}},
{`key`: "bc9cea01798e92613d7aba27|S5158BC9E65", `properties`: {`kind`: "document", `label`: "Eye Health", `id`: "S5158BC9E65", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về võng mạc đái tháo đường. Trích đoạn từ bài gốc: “We walk you through the process of eye exams and the importance of maintaining eye health when living with diabetes.”", `section`: "Võng mạc đái tháo đường", `topic`: "eyes", `category`: "eyes", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "0e2bae8d360d7b91dcc5181b5681a078c60638f698f763ed4fdbe312f8f52920", `support_quotes`: ["We walk you through the process of eye exams and the importance of maintaining eye health when living with diabetes."]}},
{`key`: "bc9cea01798e92613d7aba27|S5364E43FE4", `properties`: {`kind`: "document", `label`: "Cách đảo ngược tiền tiểu đường bằng ăn uống và vận động đúng cách", `id`: "S5364E43FE4", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về dinh dưỡng và đái tháo đường. Trích đoạn từ bài gốc: “Dinh dưỡng đóng vai trò tiên quyết trong việc kiểm soát lượng đường nạp vào cơ thể.”", `section`: "Dinh dưỡng và đái tháo đường", `topic`: "nutrition", `category`: "nutrition", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "af46dd16a99459343c96c753567f4fee92cb8931a5b0a272ff67afd5ebc46bc7", `support_quotes`: ["Dinh dưỡng đóng vai trò tiên quyết trong việc kiểm soát lượng đường nạp vào cơ thể."]}},
{`key`: "bc9cea01798e92613d7aba27|S53981FAFCB", `properties`: {`kind`: "document", `label`: "Nâng cao năng lực chẩn đoán và điều trị đái tháo đường cho các bác sĩ tuyến y tế cơ sở trên toàn quốc", `id`: "S53981FAFCB", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về xét nghiệm và sàng lọc đái tháo đường. Trích đoạn từ bài gốc: “Đặc biệt, chương trình tập huấn đã giới thiệu về ứng dụng thông minh Diabetes Journey cho các bác sỹ.”", `section`: "Xét nghiệm và sàng lọc đái tháo đường", `topic`: "screening", `category`: "screening", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "3cf939d52dd4d1221ffd02584daed054df86343dc24256684b5cae60ed6cdd0f", `support_quotes`: ["Đặc biệt, chương trình tập huấn đã giới thiệu về ứng dụng thông minh Diabetes Journey cho các bác sỹ."]}},
{`key`: "bc9cea01798e92613d7aba27|S55EBAA23E0", `properties`: {`kind`: "document", `label`: "Phát hiện và phòng ngừa tiền đái tháo đường", `id`: "S55EBAA23E0", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Tiền đái tháo đường là tình trạng tăng glucose mạn tính diễn tiến âm thầm, liên quan đến yếu tố di truyền và tình trạng kháng insulin khi cơ thể không sử dụng insulin hợp lý. Việc phát hiện sớm thông qua các xét nghiệm cùng với chế độ dinh dưỡng lành mạnh, tăng cường vận động giúp phòng ngừa hiệu quả nguy cơ tiến triển thành bệnh.", `section`: "Phát hiện và phòng ngừa tiền đái tháo đường", `topic`: "prevention", `category`: "prevention", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-21", `source_sha256`: "0cabd4f5c8d1916e7bde4839ade947a19301eb745cfe72ba8ead2ca4f9b3a4e0", `support_quotes`: ["Tuy nhiên một số người vẫn cho rằng có liên"]}},
{`key`: "bc9cea01798e92613d7aba27|S562888D386", `properties`: {`kind`: "document", `label`: "Mối liên quan giữa bệnh đái tháo đường và trầm cảm", `id`: "S562888D386", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Bài do bác sĩ Vinmec tư vấn chuyên môn đề cập đến áp lực có thể phát sinh trong quá trình kiểm soát đường huyết và mối liên quan giữa đái tháo đường với trầm cảm. Đây là thông tin để người đọc nhận diện chủ đề cần trao đổi khi đi khám, không phải căn cứ để tự xác định trầm cảm.", `section`: "Mối liên quan giữa bệnh đái tháo đường và trầm cảm", `topic`: "mental", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-21", `source_sha256`: "0e6b63d29d2512fdab37fcaa6b8c5961528658a3e22872f43bbdcaaf7c109c95", `support_quotes`: ["lại thường xuyên tạo ra áp lực chính cho bản thân"]}},
{`key`: "bc9cea01798e92613d7aba27|S588EC76F14", `properties`: {`kind`: "document", `label`: "Hạ đường huyết tiểu đường: Triệu chứng và nguyên nhân", `id`: "S588EC76F14", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về hạ đường huyết. Trích đoạn từ bài gốc: “Một số người không có bất kỳ triệu chứng đáng chú ý nào.”", `section`: "Hạ đường huyết", `topic`: "hypoglycemia", `category`: "hypoglycemia", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "11daad28493336d3687b905c4aa28be393f7de1e9846d8ec7dd744e4c1fa9117", `support_quotes`: ["Một số người không có bất kỳ triệu chứng đáng chú ý nào."]}},
{`key`: "bc9cea01798e92613d7aba27|S5BBAF0BB91", `properties`: {`kind`: "document", `label`: "Insulin for gestational diabetes", `id`: "S5BBAF0BB91", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “Insulin is a medicine that helps your body use glucose (sugar) for energy.”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "9ced6662f7f0037f48d7563d4b5c49ae8902e96242c63d51984fae5fe17aca3c", `support_quotes`: ["Insulin is a medicine that helps your body use glucose (sugar) for energy."]}},
{`key`: "bc9cea01798e92613d7aba27|S5C8A014D37", `properties`: {`kind`: "document", `label`: "Hạ đường huyết, nguy cơ không dễ nhận ra", `id`: "S5C8A014D37", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Hạ đường huyết là tình trạng lượng đường trong máu thấp bất thường, thường gặp ở người bệnh đái tháo đường đang điều trị bằng thuốc hoặc insulin khi sử dụng không đúng cách hoặc bỏ bữa. Tình trạng này có thể gây ra nhiều triệu chứng đa dạng, ảnh hưởng lớn đến chất lượng cuộc sống và đòi hỏi phải nâng cao nhận thức để phòng ngừa.", `section`: "Hạ đường huyết, nguy cơ không dễ nhận ra", `topic`: "hypoglycemia", `category`: "hypoglycemia", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-21", `source_sha256`: "4b1d465cf023d11019ba243ea33996a898be840614fd520e4816af7d6d267768", `support_quotes`: ["Hạ đường huyết là tình trạng lượng đường (glucose) trong"]}},
{`key`: "bc9cea01798e92613d7aba27|S5CD2C121B1", `properties`: {`kind`: "document", `label`: "Chẩn đoán chính xác tiểu đường thai kỳ như thế nào?", `id`: "S5CD2C121B1", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “Sau khi sổ thai, trong đa số các trường hợp thì đường huyết trở về giới hạn bình thường.”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "5a2fa596b20f0bd56af31138c5543c59e46a58ab160d6ff821020c7c846870e7", `support_quotes`: ["Sau khi sổ thai, trong đa số các trường hợp thì đường huyết trở về giới hạn bình thường."]}},
{`key`: "bc9cea01798e92613d7aba27|S5D311E5CD3", `properties`: {`kind`: "document", `label`: "Risk Factors for Type 2 Diabetes", `id`: "S5D311E5CD3", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về nguy cơ và phòng ngừa đái tháo đường. Trích đoạn từ bài gốc: “Another way to estimate your risk of developing diabetes is to measure your waist circumference.”", `section`: "Nguy cơ và phòng ngừa đái tháo đường", `topic`: "prevention", `category`: "prevention", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "e62acdaf672b6e7e11058dfccf9d49b1feb2734b431024735e03154082594dc6", `support_quotes`: ["Another way to estimate your risk of developing diabetes is to measure your waist circumference."]}},
{`key`: "bc9cea01798e92613d7aba27|S5E221F986F", `properties`: {`kind`: "document", `label`: "Chế độ dinh dưỡng và luyện tập cho người bệnh tiểu đường", `id`: "S5E221F986F", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về dinh dưỡng và đái tháo đường. Trích đoạn từ bài gốc: “Thay đổi chế độ ăn cũng góp phần điều trị béo phì , tăng huyết áp , tăng cholesterol.”", `section`: "Dinh dưỡng và đái tháo đường", `topic`: "nutrition", `category`: "nutrition", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "f6b6cae8cf9b1866f091b505b49ea230c1e5308afce26614969b914518d7e3de", `support_quotes`: ["Thay đổi chế độ ăn cũng góp phần điều trị béo phì , tăng huyết áp , tăng cholesterol."]}},
{`key`: "bc9cea01798e92613d7aba27|S5F8B303AB3", `properties`: {`kind`: "document", `label`: "Đái tháo đường ở trẻ em", `id`: "S5F8B303AB3", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường ở trẻ em. Trích đoạn từ bài gốc: “Bệnh đái tháo đường ở trẻ em ngày càng có xu hướng gia tăng.”", `section`: "Đái tháo đường ở trẻ em", `topic`: "pediatrics", `category`: "pediatrics", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "dd6884b9993860d047f148462420330a6b81832d022998c0210c1daba2df9fd5", `support_quotes`: ["Bệnh đái tháo đường ở trẻ em ngày càng có xu hướng gia tăng."]}},
{`key`: "bc9cea01798e92613d7aba27|S605F6A0797", `properties`: {`kind`: "document", `label`: "Các thuốc làm giảm chỉ số HBA1C", `id`: "S605F6A0797", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về xét nghiệm và sàng lọc đái tháo đường. Trích đoạn từ bài gốc: “Dựa vào đó, bác sĩ sẽ đưa ra các quyết định chẩn đoán và điều trị hợp lý.”", `section`: "Xét nghiệm và sàng lọc đái tháo đường", `topic`: "screening", `category`: "screening", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "e49e5255eb07a7f3e5eb0dcd3c6bc8037bb7dcd932a11a9617232f17e5748aa6", `support_quotes`: ["Dựa vào đó, bác sĩ sẽ đưa ra các quyết định chẩn đoán và điều trị hợp lý."]}},
{`key`: "bc9cea01798e92613d7aba27|S60B5FE343D", `properties`: {`kind`: "document", `label`: "Các biến chứng tim mạch trên bệnh nhân tiểu đường", `id`: "S60B5FE343D", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về biến chứng tim mạch. Trích đoạn từ bài gốc: “Điều trị mỡ máu: dùng thuốc giảm mỡ máu phòng các biến cố tim mạch.”", `section`: "Biến chứng tim mạch", `topic`: "heart", `category`: "heart", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "022770c27e44cffc0dc083f65dd822a475c8c6b986deb884fccc98b811674634", `support_quotes`: ["Điều trị mỡ máu: dùng thuốc giảm mỡ máu phòng các biến cố tim mạch."]}},
{`key`: "bc9cea01798e92613d7aba27|S62875107B3", `properties`: {`kind`: "document", `label`: "Ký kết tăng cường hợp tác đào tạo về bệnh đái tháo đường", `id`: "S62875107B3", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về tổng quan đái tháo đường. Trích đoạn từ bài gốc: “Đây cũng là công cụ hữu ích sử dụng trong đào tạo bác sỹ và sinh viên y khoa.”", `section`: "Tổng quan đái tháo đường", `topic`: "overview", `category`: "overview", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "23bf20f973f8e1e921f13b443383c143eef132e1f73e91365754618b426e5099", `support_quotes`: ["Đây cũng là công cụ hữu ích sử dụng trong đào tạo bác sỹ và sinh viên y khoa."]}},
{`key`: "bc9cea01798e92613d7aba27|S62C58292DA", `properties`: {`kind`: "document", `label`: "Hiểu biết về mối nguy hại do biến chứng đái tháo đường", `id`: "S62C58292DA", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về tổng quan đái tháo đường. Trích đoạn từ bài gốc: “Biến chứng đái tháo đường thường chia thành hai nhóm: biến chứng cấp tính và biến chứng mạn tính.”", `section`: "Tổng quan đái tháo đường", `topic`: "overview", `category`: "overview", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "32e482d66e2c48ef79b70c3ffb620eefa8ee68470bb12137e018bf954f1e4651", `support_quotes`: ["Biến chứng đái tháo đường thường chia thành hai nhóm: biến chứng cấp tính và biến chứng mạn tính."]}},
{`key`: "bc9cea01798e92613d7aba27|S64B36958EF", `properties`: {`kind`: "document", `label`: "Kháng insulin là gì? Cơ chế?", `id`: "S64B36958EF", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “Những khiếm khuyết trong hệ thống tín hiệu insulin là cơ chế quan trọng gây ra kháng insulin.”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "7ebe672b9e541dc2323e56604e67a4104f5103f48c5591780bb048668ed9556d", `support_quotes`: ["Những khiếm khuyết trong hệ thống tín hiệu insulin là cơ chế quan trọng gây ra kháng insulin."]}},
{`key`: "bc9cea01798e92613d7aba27|S6502B12F2E", `properties`: {`kind`: "document", `label`: "Tiểu đường thai kỳ ảnh hưởng thế nào tới thai nhi?", `id`: "S6502B12F2E", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “Trong quá trình có thai thấy mệt hoặc đái nhiều, khát nước nhiều hoặc bất thường cần khám lại ngay.”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "bffc807446b3429c595bfd2d384b136370ae7432acbc97520069d25e9b178b15", `support_quotes`: ["Trong quá trình có thai thấy mệt hoặc đái nhiều, khát nước nhiều hoặc bất thường cần khám lại ngay."]}},
{`key`: "bc9cea01798e92613d7aba27|S663C27AD48", `properties`: {`kind`: "document", `label`: "10 loại kháng sinh điều trị loét bàn chân tiểu đường bạn có biết", `id`: "S663C27AD48", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về chăm sóc bàn chân. Trích đoạn từ bài gốc: “Vancomycin là kháng sinh điều trị loét bàn chân tiểu đường dạng tiêm.”", `section`: "Chăm sóc bàn chân", `topic`: "feet", `category`: "feet", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "d483938c0e8cd7a272cb7dca6b0620e932a105123130a1583699a4d45189f238", `support_quotes`: ["Vancomycin là kháng sinh điều trị loét bàn chân tiểu đường dạng tiêm."]}},
{`key`: "bc9cea01798e92613d7aba27|S6721BD0A81", `properties`: {`kind`: "document", `label`: "Bệnh thận đái tháo đường xảy ra như thế nào?", `id`: "S6721BD0A81", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Bệnh thận đái tháo đường là biến chứng tổn thương thận do bệnh tiểu đường gây ra, có thể dẫn đến suy thận nếu không điều trị kịp thời. Khi mắc bệnh, các mạch máu nhỏ trong thận bị tổn thương khiến thận không thể làm sạch mạch máu, giữ lại muối nước và tích tụ chất thải trong cơ thể.", `section`: "Bệnh thận đái tháo đường xảy ra như thế nào?", `topic`: "kidney", `category`: "kidney", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-21", `source_sha256`: "71d0a6467090bebb8d3484e354d3ee27b57e5d309fb04bf9c376ccc712e72458", `support_quotes`: ["bệnh thận đái tháo đường là tổn thương thận do"]}},
{`key`: "bc9cea01798e92613d7aba27|S687AD3F58F", `properties`: {`kind`: "document", `label`: "Các lựa chọn quản lý bệnh tim mạch xơ vữa với bệnh nhân đái tháo đường típ 2", `id`: "S687AD3F58F", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về biến chứng tim mạch. Trích đoạn từ bài gốc: “Nhóm thuốc này không làm nặng thêm bệnh lý tim mạch.”", `section`: "Biến chứng tim mạch", `topic`: "heart", `category`: "heart", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "bf698c115b5aa479a7944e1f09ae1662bb9bcb465b4497dfd98e2aa80ae8b974", `support_quotes`: ["Nhóm thuốc này không làm nặng thêm bệnh lý tim mạch."]}},
{`key`: "bc9cea01798e92613d7aba27|S69B7DAB7A6", `properties`: {`kind`: "document", `label`: "Các xét nghiệm cần thực hiện trong chẩn đoán đái tháo đường", `id`: "S69B7DAB7A6", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về xét nghiệm và sàng lọc đái tháo đường. Trích đoạn từ bài gốc: “Trên thực tế, người bệnh thường được khuyên thực hiện xét nghiệm vào sáng sớm, khi chưa ăn gì.”", `section`: "Xét nghiệm và sàng lọc đái tháo đường", `topic`: "screening", `category`: "screening", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "93015fb71f6be1e7b7806b6137dad1b48ab2816cda1fb265451505ba15a3ecfd", `support_quotes`: ["Trên thực tế, người bệnh thường được khuyên thực hiện xét nghiệm vào sáng sớm, khi chưa ăn gì."]}},
{`key`: "bc9cea01798e92613d7aba27|S6B99F85F13", `properties`: {`kind`: "document", `label`: "TẠI SAO TÔI BỊ HẠ ĐƯỜNG HUYẾT?", `id`: "S6B99F85F13", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về hạ đường huyết. Trích đoạn từ bài gốc: “Hạ đường huyết có thể xảy ra ở những người mắc hoặc không mắc bệnh tiểu đường (đái tháo đường).”", `section`: "Hạ đường huyết", `topic`: "hypoglycemia", `category`: "hypoglycemia", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "c74de55f197d2281774254b804065a98a6fe6d392aaad772e0a5cc7f3b2e2b9c", `support_quotes`: ["Hạ đường huyết có thể xảy ra ở những người mắc hoặc không mắc bệnh tiểu đường (đái tháo đường)."]}},
{`key`: "bc9cea01798e92613d7aba27|S6CACD5DC24", `properties`: {`kind`: "document", `label`: "Tăng cơ hội bảo tồn chi thể cho người bệnh đái tháo đường", `id`: "S6CACD5DC24", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Báo Sức khỏe & Đời sống đưa tin về hoạt động hỗ trợ chuyên môn giữa Bệnh viện Nội tiết Trung ương và Bệnh viện Nội tiết Nghệ An. Bài viết cho thấy vai trò của phối hợp chuyên khoa đối với các ca loét bàn chân phức tạp ở người mắc đái tháo đường.", `section`: "Hỗ trợ chuyên sâu về chăm sóc bàn chân", `topic`: "feet", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-11-21", `source_sha256`: "e6b8883367f3009e0c311109eb3ae34ae253e218706c79944411ec90bcb3b5bd", `support_quotes`: ["chia sẻ kinh nghiệm xử trí những trường hợp loét bàn chân đái tháo đường phức tạp"]}},
{`key`: "bc9cea01798e92613d7aba27|S6D0BE335CF", `properties`: {`kind`: "document", `label`: "Know Your Facts About Diabetes", `id`: "S6D0BE335CF", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về tổng quan đái tháo đường. Trích đoạn từ bài gốc: “Diabetes can be confusing, but we are committed to helping you understand the facts about diabetes.”", `section`: "Tổng quan đái tháo đường", `topic`: "overview", `category`: "overview", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "942b3302962514ec2c1282772159b0d7a0f40d2f35eba580094bce44989bf015", `support_quotes`: ["Diabetes can be confusing, but we are committed to helping you understand the facts about diabetes."]}},
{`key`: "bc9cea01798e92613d7aba27|S6D57307F2F", `properties`: {`kind`: "document", `label`: "Dinh dưỡng trong bệnh đái tháo đường", `id`: "S6D57307F2F", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về dinh dưỡng và đái tháo đường. Trích đoạn từ bài gốc: “Giờ giấc ăn phải ổn định, phù hợp với thời gian dùng thuốc.”", `section`: "Dinh dưỡng và đái tháo đường", `topic`: "nutrition", `category`: "nutrition", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "3a64d2eecf1d0bdbbd95736e875df7a6175873f1dc8df7b6999ca58953b268cc", `support_quotes`: ["Giờ giấc ăn phải ổn định, phù hợp với thời gian dùng thuốc."]}},
