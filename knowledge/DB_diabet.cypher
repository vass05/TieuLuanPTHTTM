{`key`: "bc9cea01798e92613d7aba27|S720BC25AC4", `properties`: {`kind`: "document", `label`: "Nhiễm toan ceton ở bệnh nhân đái tháo đường", `id`: "S720BC25AC4", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về tăng đường huyết. Trích đoạn từ bài gốc: “Điều trị nhiễm khuẩn kết hợp: Chỉ định dùng kháng sinh.”", `section`: "Tăng đường huyết", `topic`: "hyperglycemia", `category`: "hyperglycemia", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "28b7db53cef96a13f3411e69620dff82a40e3164151f3ae38229174828e562c3", `support_quotes`: ["Điều trị nhiễm khuẩn kết hợp: Chỉ định dùng kháng sinh."]}},
