{`key`: "bc9cea01798e92613d7aba27|K92", `properties`: {`kind`: "document", `label`: "Hiểu về xét nghiệm HbA1c trong bệnh tiểu đường", `id`: "K92", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Xét nghiệm HbA1c đo lượng đường huyết trung bình trong vòng hai đến ba tháng qua, phản ánh mức độ gắn kết giữa glucose và tế bào hồng cầu. Chỉ số này đóng vai trò quan trọng giúp đội ngũ y tế đánh giá mức độ kiểm soát bệnh và định hướng kế hoạch điều trị.", `section`: "Hiểu về xét nghiệm HbA1c trong bệnh tiểu đường", `topic`: "understanding_hba1c", `category`: "monitoring", `content_type`: "source_based_vietnamese_paraphrase", `reviewed_on`: "2026-10-31", `source_sha256`: "c3ec9c1dc4b78fab6b615856e79a2a09e6e1a73261226e3535ed5faa8b03a517", `support_quotes`: ["HbA1c is your average blood glucose (sugar) levels",
