{`key`: "bc9cea01798e92613d7aba27|S75330E6556", `properties`: {`kind`: "document", `label`: "Chỉ số glucose máu sau điều trị tiểu đường thai kỳ bao nhiêu là bình thường ?", `id`: "S75330E6556", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “Bác sĩ chẩn đoán em bị tiểu đường thai kỳ và hướng dẫn thay đổi cách ăn uống.”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "b6acf533b27bfd62f7be53744f70f23d6f44e5f809ad44c70d1c7ceeb5953cdd", `support_quotes`: ["Bác sĩ chẩn đoán em bị tiểu đường thai kỳ và hướng dẫn thay đổi cách ăn uống."]}},
{`key`: "bc9cea01798e92613d7aba27|S766F5EADCB", `properties`: {`kind`: "document", `label`: "Bệnh võng mạc do tiểu đường nguy hiểm thế nào?", `id`: "S766F5EADCB", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về võng mạc đái tháo đường. Trích đoạn từ bài gốc: “Các chất dịch thoát ra từ mạch máu sẽ tích tụ làm lớp võng mạc bị tách ra.”", `section`: "Võng mạc đái tháo đường", `topic`: "eyes", `category`: "eyes", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "17e79eb007b609bfc27644cd72f4692da82097aa0458d6f660c939704d3bbdab", `support_quotes`: ["Các chất dịch thoát ra từ mạch máu sẽ tích tụ làm lớp võng mạc bị tách ra."]}},
{`key`: "bc9cea01798e92613d7aba27|S76B6463432", `properties`: {`kind`: "document", `label`: "Quản lý và điều trị bệnh suy thận do đái tháo đường", `id`: "S76B6463432", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về bệnh thận do đái tháo đường. Trích đoạn từ bài gốc: “Dinh dưỡng và điều trị bổ sung cho bệnh suy thận do đái tháo đường.”", `section`: "Bệnh thận do đái tháo đường", `topic`: "kidney", `category`: "kidney", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "d3b7f2b57f6c154d83e97ebf96feb1cb674a90e5a743861ffd88582f6d74b098", `support_quotes`: ["Dinh dưỡng và điều trị bổ sung cho bệnh suy thận do đái tháo đường."]}},
{`key`: "bc9cea01798e92613d7aba27|S77A29859A7", `properties`: {`kind`: "document", `label`: "24 thực phẩm giúp bạn kiểm soát bệnh tiểu đường", `id`: "S77A29859A7", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về dinh dưỡng và đái tháo đường. Trích đoạn từ bài gốc: “Quả việt quất cũng có lợi trong việc kiểm soát bệnh tiểu đường.”", `section`: "Dinh dưỡng và đái tháo đường", `topic`: "nutrition", `category`: "nutrition", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "f93f5d108a1beb6a1dd30fb6936b2bbfd257ac312eec0762f4504234b87904bd", `support_quotes`: ["Quả việt quất cũng có lợi trong việc kiểm soát bệnh tiểu đường."]}},
{`key`: "bc9cea01798e92613d7aba27|S77AA082724", `properties`: {`kind`: "document", `label`: "Khi bạn cần nhiều hơn 1 thuốc cho bệnh tiểu đường type 2?", `id`: "S77AA082724", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “Khi chế độ điều trị thay đổi (thêm thuốc), người bệnh cần đến gặp bác sĩ thường xuyên hơn.”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "0764b744918ea6493fc793dee5f7d1d6b0132776ebdab9c8ea826b82b6fcf035", `support_quotes`: ["Khi chế độ điều trị thay đổi (thêm thuốc), người bệnh cần đến gặp bác sĩ thường xuyên hơn."]}},
{`key`: "bc9cea01798e92613d7aba27|S794DF2B35D", `properties`: {`kind`: "document", `label`: "11 loại nước uống tốt cho bệnh nhân tiểu đường", `id`: "S794DF2B35D", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về dinh dưỡng và đái tháo đường. Trích đoạn từ bài gốc: “Lời khuyên là nên uống nước ép củ cải đường mỗi ngày một lần.”", `section`: "Dinh dưỡng và đái tháo đường", `topic`: "nutrition", `category`: "nutrition", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "3e971eab015d453dadd09f7273fa34cd90536988caa6a67c52bb5805878ea386", `support_quotes`: ["Lời khuyên là nên uống nước ép củ cải đường mỗi ngày một lần."]}},
{`key`: "bc9cea01798e92613d7aba27|S79FD26489A", `properties`: {`kind`: "document", `label`: "Chỉ số tiểu đường thai kỳ bao nhiêu là nguy hiểm?", `id`: "S79FD26489A", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “Đái tháo đường thai kỳ có thể gây ra nhiều biến chứng nguy hiểm cho cả mẹ và thai nhi.”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "b60eeb7a4077e8ac866e23bf15796421debdf3447648119fe97c8edab744c533", `support_quotes`: ["Đái tháo đường thai kỳ có thể gây ra nhiều biến chứng nguy hiểm cho cả mẹ và thai nhi."]}},
{`key`: "bc9cea01798e92613d7aba27|S7AC0000A29", `properties`: {`kind`: "document", `label`: "Bị tiểu đường thai kỳ có thể sinh thường không?", `id`: "S7AC0000A29", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về đái tháo đường và thai kỳ. Trích đoạn từ bài gốc: “Nhưng do rối loạn nên em đã bị tiểu đường thai kỳ .”", `section`: "Đái tháo đường và thai kỳ", `topic`: "pregnancy", `category`: "pregnancy", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "e85ace0f7631a667b694a5ee1de9b658e1843c352b453ff4dbf008639a6a630b", `support_quotes`: ["Nhưng do rối loạn nên em đã bị tiểu đường thai kỳ ."]}},
{`key`: "bc9cea01798e92613d7aba27|S7BAA057D46", `properties`: {`kind`: "document", `label`: "10 Lời Khuyên Cho Bệnh Nhân Đái Tháo Đường TÍP 2 Để Kiểm Soát Mức Đường Huyết Tốt Hơn", `id`: "S7BAA057D46", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về tổng quan đái tháo đường. Trích đoạn từ bài gốc: “Chế độ ăn quyết định rất nhiều đến sự kiểm soát đường huyết.”", `section`: "Tổng quan đái tháo đường", `topic`: "overview", `category`: "overview", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "f5fbff5aa09b4c7ab9fba28c607e6fa773d0c2adb4063dc8a275f7a2e636d589", `support_quotes`: ["Chế độ ăn quyết định rất nhiều đến sự kiểm soát đường huyết."]}},
{`key`: "bc9cea01798e92613d7aba27|S7BD2795DBB", `properties`: {`kind`: "document", `label`: "4 cách chẩn đoán đái tháo đường type 1 có thể bạn chưa biết", `id`: "S7BD2795DBB", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về xét nghiệm và sàng lọc đái tháo đường. Trích đoạn từ bài gốc: “Lúc này người bệnh chưa cần insulin hoặc cần rất ít (gọi là giai đoạn “trăng mật”).”", `section`: "Xét nghiệm và sàng lọc đái tháo đường", `topic`: "screening", `category`: "screening", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "12aac654c9df8b426854675a53d0acffbf48d2bd9666edfa2be125c351f67745", `support_quotes`: ["Lúc này người bệnh chưa cần insulin hoặc cần rất ít (gọi là giai đoạn “trăng mật”)."]}},
{`key`: "bc9cea01798e92613d7aba27|S7C14F3F507", `properties`: {`kind`: "document", `label`: "Thời gian tác dụng của một số loại Insulin", `id`: "S7C14F3F507", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về thuốc điều trị đái tháo đường. Trích đoạn từ bài gốc: “Dó đó nên sử dụng cùng một vùng tiêm cho mũi tiêm vào cùng khoảng thời gian trong ngày.”", `section`: "Thuốc điều trị đái tháo đường", `topic`: "medicines", `category`: "medicines", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "19666b5fac02e20581b57e8bf39a87904f96d5d259a5c061874cfaa961a62111", `support_quotes`: ["Dó đó nên sử dụng cùng một vùng tiêm cho mũi tiêm vào cùng khoảng thời gian trong ngày."]}},
{`key`: "bc9cea01798e92613d7aba27|S7DABB7A719", `properties`: {`kind`: "document", `label`: "Buồng trứng đa nang: Nguy cơ vô sinh, tiểu đường, huyết áp...", `id`: "S7DABB7A719", `kb_version`: "bc9cea01798e92613d7aba27", `summary_vi`: "Nguồn tham khảo về nguy cơ và phòng ngừa đái tháo đường. Trích đoạn từ bài gốc: “Đa nang buồng trứng là bệnh lý nguy hiểm gây vô sinh, hiếm muộn ở phụ nữ.”", `section`: "Nguy cơ và phòng ngừa đái tháo đường", `topic`: "prevention", `category`: "prevention", `content_type`: "attributed_source_excerpt", `reviewed_on`: "2026-11-21", `source_sha256`: "99749f1aa1ffe4f2af9ea30105da48dd7aedab76c2aea9f405a866ad00f8f010", `support_quotes`: ["Đa nang buồng trứng là bệnh lý nguy hiểm gây vô sinh, hiếm muộn ở phụ nữ."]}},
